{
 "schema_version": "1.0.0",
 "name": "Default QA gates",
 "note": "The default seven gates. Copy and edit: add or remove steps, change criteria and approvers, add each validator's arguments (paths to the inputs each skill's validator needs). auto_approve is off everywhere: a person approves each gate until the team decides otherwise.",
 "gates": [
  {"id": "G1", "name": "Ready", "approver": "QA lead", "auto_approve": false,
   "steps": [{"id": "readiness", "skill": "ticket-readiness-reviewer", "purpose": "Are the acceptance criteria testable?",
              "validator": "python {skills}/ticket-readiness-reviewer-skill/scripts/validate_readiness.py {report}"}],
   "criteria": [{"id": "readiness-valid", "kind": "report_valid", "step": "readiness"},
                {"id": "ticket-ready", "kind": "field_in", "step": "readiness", "path": "reviews[0].verdict.value", "values": ["ready", "ready_with_questions"]}]},
  {"id": "G2", "name": "Designed", "approver": "QA lead", "auto_approve": false,
   "steps": [{"id": "cases", "skill": "test-case-designer", "purpose": "Test cases per criterion",
              "validator": "python {skills}/test-case-designer-skill/scripts/validate_cases.py {report}"},
             {"id": "risk-plan", "skill": "risk-based-test-planner", "required": false, "purpose": "Effort by risk for the release",
              "validator": "python {skills}/risk-based-test-planner-skill/scripts/validate_test_plan.py {report}"}],
   "criteria": [{"id": "cases-valid", "kind": "report_valid", "step": "cases"},
                {"id": "all-rows-covered", "kind": "field_equals_field", "step": "cases", "path": "summary.rows_covered", "other": "summary.rows_total"}]},
  {"id": "G3", "name": "Built and tested", "approver": "Engineering lead", "auto_approve": false,
   "steps": [{"id": "tdd", "skill": "ticket-to-tdd", "purpose": "Red tests for the ticket, then green",
              "validator": "python {skills}/ticket-to-tdd-skill/scripts/validate_tdd_report.py {report}"},
             {"id": "security", "skill": "code-security-auditor", "purpose": "Security review of the change",
              "validator": "python {skills}/code-security-auditor-skill/scripts/validate_security_audit.py {report}"}],
   "criteria": [{"id": "tdd-valid", "kind": "report_valid", "step": "tdd"}, {"id": "security-valid", "kind": "report_valid", "step": "security"},
                {"id": "no-p0-security", "kind": "field_compare", "step": "security", "path": "summary.counts.by_priority.P0", "op": "==", "value": 0}]},
  {"id": "G4", "name": "Verified in CI", "approver": "QA lead", "auto_approve": false,
   "steps": [{"id": "suite", "skill": "ci-suite-runner", "purpose": "The regression suite in CI on staging",
              "validator": "python {skills}/ci-suite-runner-skill/scripts/validate_suite_run.py {report}"},
             {"id": "triage", "skill": "ci-failure-triager", "required": false, "purpose": "Classify any failures",
              "validator": "python {skills}/ci-failure-triager-skill/scripts/validate_triage.py {report}"}],
   "criteria": [{"id": "suite-valid", "kind": "report_valid", "step": "suite"},
                {"id": "no-failed-tests", "kind": "field_compare", "step": "suite", "path": "results.totals.failed", "op": "==", "value": 0}]},
  {"id": "G5", "name": "Release ready", "approver": "Release manager", "auto_approve": false,
   "steps": [{"id": "gate", "skill": "release-readiness-gate", "purpose": "Go, no-go or not established from all reports",
              "validator": "python {skills}/release-readiness-gate-skill/scripts/validate_gate.py {report} --reports"}],
   "criteria": [{"id": "gate-valid", "kind": "report_valid", "step": "gate"},
                {"id": "gate-go", "kind": "field_in", "step": "gate", "path": "headline.verdict", "values": ["go"]}]},
  {"id": "G6", "name": "Deployed", "approver": "Release manager", "auto_approve": false,
   "steps": [{"id": "pvt", "skill": "post-deploy-validator", "purpose": "Read-only checks after the deploy",
              "validator": "python {skills}/post-deploy-validator-skill/scripts/validate_pvt.py {report}"}],
   "criteria": [{"id": "pvt-valid", "kind": "report_valid", "step": "pvt"},
                {"id": "pvt-go", "kind": "field_in", "step": "pvt", "path": "recommendation.value", "values": ["go"]}]},
  {"id": "G7", "name": "Hypercare", "approver": "On-call lead", "auto_approve": false,
   "steps": [{"id": "watch", "skill": "hypercare-anomaly-watcher", "purpose": "Watch the release for the hypercare window",
              "validator": "python {skills}/hypercare-anomaly-watcher-skill/scripts/validate_watch.py {report}"}],
   "criteria": [{"id": "watch-valid", "kind": "report_valid", "step": "watch"},
                {"id": "no-drafts", "kind": "field_compare", "step": "watch", "path": "drafts.length", "op": "==", "value": 0}]}
 ]
}

{
 "schema_version": "1.0.0",
 "name": "Example: loyalty points change, four gates then deploy and hypercare",
 "note": "A shortened configuration for the example: Ready, Designed, Verified in CI, Release ready, Deployed, Hypercare. Validator commands carry the arguments each example report needs; paths are relative to the repository root.",
 "gates": [
  {"id": "G1", "name": "Ready", "approver": "QA lead", "auto_approve": false,
   "steps": [{"id": "readiness", "skill": "ticket-readiness-reviewer", "purpose": "Are the acceptance criteria testable?",
              "validator": "python {skills}/ticket-readiness-reviewer-skill/scripts/validate_readiness.py {report} --tickets {skills}/ticket-readiness-reviewer-skill/examples/tickets.json --lint {skills}/ticket-readiness-reviewer-skill/examples/lint.json"}],
   "criteria": [{"id": "readiness-valid", "kind": "report_valid", "step": "readiness"},
                {"id": "ticket-ready", "kind": "field_in", "step": "readiness", "path": "reviews[ticket.key=SHOP-201].verdict.value", "values": ["ready", "ready_with_questions"]}]},
  {"id": "G2", "name": "Designed", "approver": "QA lead", "auto_approve": false,
   "steps": [{"id": "cases", "skill": "test-case-designer", "purpose": "Test cases per criterion",
              "validator": "python {skills}/test-case-designer-skill/scripts/validate_cases.py {report} --ticket {skills}/test-case-designer-skill/examples/run/ticket.json --model {skills}/test-case-designer-skill/examples/model.json --rows {skills}/test-case-designer-skill/examples/run/rows.json"}],
   "criteria": [{"id": "cases-valid", "kind": "report_valid", "step": "cases"},
                {"id": "all-rows-covered", "kind": "field_equals_field", "step": "cases", "path": "summary.rows_covered", "other": "summary.rows_total"}]},
  {"id": "G3", "name": "Verified in CI", "approver": "QA lead", "auto_approve": false,
   "steps": [{"id": "suite", "skill": "ci-suite-runner", "purpose": "The checkout regression in CI on staging",
              "cwd": "{skills}/ci-suite-runner-skill",
              "validator": "python scripts/validate_suite_run.py {report} --preauth examples/preauth.json --stub-log examples/runs/stub_log.json"},
             {"id": "triage", "skill": "ci-failure-triager", "purpose": "Classify the failures",
              "validator": "python {skills}/ci-failure-triager-skill/scripts/validate_triage.py {report} --run {skills}/ci-failure-triager-skill/examples/run"}],
   "criteria": [{"id": "suite-valid", "kind": "report_valid", "step": "suite"}, {"id": "triage-valid", "kind": "report_valid", "step": "triage"},
                {"id": "no-failed-tests", "kind": "field_compare", "step": "suite", "path": "results.totals.failed", "op": "==", "value": 0},
                {"id": "no-real-failures", "kind": "field_compare", "step": "triage", "path": "summary.by_classification.real", "op": "==", "value": 0}]},
  {"id": "G4", "name": "Release ready", "approver": "Release manager", "auto_approve": false,
   "steps": [{"id": "gate", "skill": "release-readiness-gate", "purpose": "Go, no-go or not established from the release's reports",
              "validator": "python {skills}/release-readiness-gate-skill/scripts/validate_gate.py {report} --reports"}],
   "criteria": [{"id": "gate-valid", "kind": "report_valid", "step": "gate"},
                {"id": "gate-go", "kind": "field_in", "step": "gate", "path": "headline.verdict", "values": ["go"]}]},
  {"id": "G5", "name": "Deployed", "approver": "Release manager", "auto_approve": false,
   "steps": [{"id": "pvt", "skill": "post-deploy-validator", "purpose": "Read-only checks after the deploy",
              "validator": "python {skills}/post-deploy-validator-skill/scripts/validate_pvt.py {report} --run {skills}/post-deploy-validator-skill/examples/runs/release-1.9.0/run.json"}],
   "criteria": [{"id": "pvt-valid", "kind": "report_valid", "step": "pvt"},
                {"id": "pvt-go", "kind": "field_in", "step": "pvt", "path": "recommendation.value", "values": ["go"]}]},
  {"id": "G6", "name": "Hypercare", "approver": "On-call lead", "auto_approve": false,
   "steps": [{"id": "watch", "skill": "hypercare-anomaly-watcher", "purpose": "Watch the release for the hypercare window",
              "validator": "python {skills}/hypercare-anomaly-watcher-skill/scripts/validate_watch.py {report}"}],
   "criteria": [{"id": "watch-valid", "kind": "report_valid", "step": "watch"}]}
 ]
}

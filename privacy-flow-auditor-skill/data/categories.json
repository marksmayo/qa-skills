{
  "note": "Data categories. sensitivity: 4 special or sensitive, 3 government identifier / financial / precise location, 2 contact / identity / identifiers, 1 coarse or derived. Patterns match field names, labels, autocomplete tokens and input types (case-insensitive). Children's services raise every category one level (max 4).",
  "categories": {
    "contact": {"sensitivity": 2, "label": "Contact details",
      "names": ["email", "e-mail", "mail", "phone", "mobile", "tel", "telephone", "address", "street", "postcode", "zip", "suburb"],
      "autocomplete": ["email", "tel", "tel-national", "street-address", "address-line1", "address-line2", "postal-code"],
      "types": ["email", "tel"]},
    "identity": {"sensitivity": 2, "label": "Identity",
      "names": ["name", "first_name", "firstname", "last_name", "lastname", "surname", "full_name", "given_name", "family_name", "username", "gender", "title"],
      "autocomplete": ["name", "given-name", "family-name", "username", "sex", "honorific-prefix"],
      "types": []},
    "date_of_birth": {"sensitivity": 2, "label": "Date of birth (identity)",
      "names": ["dob", "date_of_birth", "birthdate", "birth_date", "birthday"],
      "autocomplete": ["bday", "bday-day", "bday-month", "bday-year"], "types": []},
    "government_identifier": {"sensitivity": 3, "label": "Government identifier",
      "names": ["medicare", "tfn", "tax_file", "passport", "licence", "license_number", "ssn", "national_id", "nino", "ihi"],
      "autocomplete": [], "types": []},
    "financial": {"sensitivity": 3, "label": "Financial",
      "names": ["card", "card_number", "cc", "cvv", "cvc", "iban", "bsb", "account_number", "income", "salary"],
      "autocomplete": ["cc-number", "cc-csc", "cc-exp", "cc-name", "transaction-amount"], "types": []},
    "precise_location": {"sensitivity": 3, "label": "Precise location",
      "names": ["latitude", "longitude", "lat", "lng", "geolocation", "gps"], "autocomplete": [], "types": [],
      "apis": ["navigator.geolocation", "ACCESS_FINE_LOCATION", "NSLocationWhenInUseUsageDescription", "NSLocationAlwaysAndWhenInUseUsageDescription"]},
    "coarse_location": {"sensitivity": 1, "label": "Coarse location", "names": ["country", "region", "state", "city", "timezone"],
      "autocomplete": ["country", "country-name", "address-level1", "address-level2"], "types": [],
      "apis": ["ACCESS_COARSE_LOCATION"]},
    "device_identifier": {"sensitivity": 2, "label": "Device identifier", "names": ["device_id", "idfa", "gaid", "aaid", "imei", "android_id", "advertising_id"],
      "autocomplete": [], "types": [], "apis": ["AdvertisingIdClient", "ASIdentifierManager", "READ_PHONE_STATE", "AD_ID", "NSUserTrackingUsageDescription"]},
    "online_identifier": {"sensitivity": 2, "label": "Online identifier", "names": ["user_id", "userid", "client_id", "cid", "ip", "ip_address", "cookie_id", "session_id"],
      "autocomplete": [], "types": []},
    "health": {"sensitivity": 4, "label": "Health (special category)",
      "names": ["reason", "reason_for_visit", "symptom", "symptoms", "diagnosis", "condition", "medication", "allergy", "allergies", "medical", "health", "pregnan", "disability"],
      "autocomplete": [], "types": [], "apis": ["HealthKit", "NSHealthShareUsageDescription", "BODY_SENSORS", "ACTIVITY_RECOGNITION"]},
    "biometric": {"sensitivity": 4, "label": "Biometric (special category)", "names": ["fingerprint", "faceprint", "face_id", "voiceprint", "biometric"],
      "autocomplete": [], "types": [], "apis": ["USE_BIOMETRIC", "NSFaceIDUsageDescription"]},
    "racial_or_ethnic_origin": {"sensitivity": 4, "label": "Racial or ethnic origin (special category)", "names": ["ethnicity", "race", "indigenous", "atsi"], "autocomplete": [], "types": []},
    "religion": {"sensitivity": 4, "label": "Religious beliefs (special category)", "names": ["religion", "faith"], "autocomplete": [], "types": []},
    "sexual_orientation": {"sensitivity": 4, "label": "Sex life or sexual orientation (special category)", "names": ["sexual_orientation", "orientation", "sexuality"], "autocomplete": [], "types": []},
    "criminal_record": {"sensitivity": 4, "label": "Criminal record (special category)", "names": ["criminal", "conviction", "offence", "offense"], "autocomplete": [], "types": []},
    "political_opinion": {"sensitivity": 4, "label": "Political opinions (special category)", "names": ["political", "party_membership"], "autocomplete": [], "types": []},
    "trade_union": {"sensitivity": 4, "label": "Trade union membership (special category)", "names": ["union_member", "trade_union"], "autocomplete": [], "types": []},
    "genetic": {"sensitivity": 4, "label": "Genetic data (special category)", "names": ["genetic", "dna", "genome"], "autocomplete": [], "types": []},
    "contacts_and_media": {"sensitivity": 2, "label": "Contacts, photos and media", "names": [], "autocomplete": [], "types": [],
      "apis": ["READ_CONTACTS", "NSContactsUsageDescription", "NSPhotoLibraryUsageDescription", "CAMERA", "NSCameraUsageDescription", "RECORD_AUDIO", "NSMicrophoneUsageDescription"]},
    "browsing_behaviour": {"sensitivity": 1, "label": "Browsing behaviour (derived)", "names": ["page_url", "referrer", "dl", "dr"], "autocomplete": [], "types": []}
  },
  "special": ["health", "biometric", "racial_or_ethnic_origin", "religion", "sexual_orientation", "criminal_record", "political_opinion", "trade_union", "genetic"],
  "generic_property_names": {
    "note": "Collected field names that are also everyday property names in code (path.name, el.title, event.type, store.state). scan_privacy.py does not count obj.<name> as naming the field for these; it still counts the bare identifier, a key ('name': or ['name']) and an interpolation of the identifier.",
    "names": ["name", "title", "type", "state", "region", "country", "city", "timezone", "address", "card", "condition", "reason", "health", "ip", "cid", "dl", "dr", "mail", "tel", "mobile", "zip", "race", "faith", "union_member", "lat", "lng", "gps", "medical", "dna"]
  }
}

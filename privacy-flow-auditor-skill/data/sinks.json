{
  "note": "Sink patterns for scan_privacy.py (Python regexes, matched over each file with ^ and $ at line ends). hints: literal strings of which every match contains at least one (case-sensitive; collection_hints for html_input are matched on the lower-cased text); a file with none of them is not searched with that pattern, which keeps a large repository fast. Keep the hints in step with the pattern: a missing hint hides matches. kind: log, analytics, replay, error_tracker, storage, http, identify. Vendor names come from the call shape only when the pattern is vendor-specific; generic shapes (.identify, .track) name no vendor.",
  "sinks": [
    {"id": "py-logging", "kind": "log", "langs": ["py"], "pattern": "\\b(logger|logging|log)\\.(debug|info|warning|warn|error|exception|critical)\\(", "hints": ["logger.", "logging.", "log."]},
    {"id": "py-print", "kind": "log", "langs": ["py"], "pattern": "^\\s*print\\(", "hints": ["print("]},
    {"id": "js-console", "kind": "log", "langs": ["js", "ts", "html"], "pattern": "\\bconsole\\.(log|info|warn|error|debug)\\(", "hints": ["console."]},
    {"id": "js-logger", "kind": "log", "langs": ["js", "ts"], "pattern": "\\b(logger|log|pino|winston)\\.(trace|debug|info|warn|warning|error|fatal|log)\\(", "hints": ["logger.", "log.", "pino.", "winston."]},
    {"id": "android-log", "kind": "log", "langs": ["java", "kt"], "pattern": "\\bLog\\.[dviwe]\\(", "hints": ["Log."]},
    {"id": "ios-log", "kind": "log", "langs": ["swift", "m"], "pattern": "\\b(NSLog|os_log|print)\\(", "hints": ["NSLog(", "os_log(", "print("]},
    {"id": "go-log", "kind": "log", "langs": ["go"], "pattern": "\\b(log|slog|logger|logrus|zap|zerolog|klog)\\.(Print|Printf|Println|Fatal|Fatalf|Fatalln|Panic|Panicf|Info|Infof|Infow|Warn|Warnf|Warnw|Error|Errorf|Errorw|Debug|Debugf|Debugw|Trace|Tracef)\\(|\\bfmt\\.Fprint(f|ln)?\\(\\s*os\\.Std(err|out)", "hints": ["log.", "slog.", "logger.", "logrus.", "zap.", "zerolog.", "klog.", "fmt.Fprint"]},
    {"id": "go-http", "kind": "http", "langs": ["go"], "pattern": "\\bhttp\\.(Post|PostForm|Get|Head|NewRequest|NewRequestWithContext)\\(", "hints": ["http."]},
    {"id": "ruby-logger", "kind": "log", "langs": ["rb"], "pattern": "\\b(Rails\\.logger|logger)\\.(debug|info|warn|error)\\b", "hints": ["logger."]},
    {"id": "gtag", "kind": "analytics", "vendor": "Google Analytics", "langs": ["js", "ts", "html"], "pattern": "\\bgtag\\(", "hints": ["gtag("]},
    {"id": "fbq", "kind": "analytics", "vendor": "Meta Pixel", "langs": ["js", "ts", "html"], "pattern": "\\bfbq\\(", "hints": ["fbq("]},
    {"id": "segment", "kind": "analytics", "vendor": "Segment", "langs": ["js", "ts", "html"], "pattern": "\\banalytics\\.(track|identify|page)\\(", "hints": ["analytics."]},
    {"id": "posthog", "kind": "analytics", "vendor": "PostHog", "langs": ["js", "ts", "html"], "pattern": "\\bposthog\\.(capture|identify|init)\\(", "hints": ["posthog."]},
    {"id": "mixpanel", "kind": "analytics", "vendor": "Mixpanel", "langs": ["js", "ts", "html"], "pattern": "\\bmixpanel\\.(track|identify|people\\.set)\\(", "hints": ["mixpanel."]},
    {"id": "generic-track", "kind": "analytics", "langs": ["js", "ts", "html"], "pattern": "\\b\\w+\\.(track|trackEvent|logEvent)\\(", "hints": [".track(", ".trackEvent(", ".logEvent("]},
    {"id": "generic-identify", "kind": "identify", "langs": ["js", "ts", "html"], "pattern": "\\b\\w+\\.(identify|setUser|setUserProperties|setUserId)\\(", "hints": [".identify(", ".setUser", ".setUserId("]},
    {"id": "pixel-image", "kind": "http", "langs": ["js", "ts", "html"], "pattern": "new Image\\(\\)|\\.src\\s*=\\s*['\"`]https?://", "hints": ["new Image()", ".src"]},
    {"id": "beacon", "kind": "http", "langs": ["js", "ts", "html"], "pattern": "navigator\\.sendBeacon\\(", "hints": ["sendBeacon("]},
    {"id": "fetch", "kind": "http", "langs": ["js", "ts", "html"], "pattern": "\\bfetch\\(|XMLHttpRequest|axios\\.(get|post)", "hints": ["fetch(", "XMLHttpRequest", "axios."]},
    {"id": "py-http", "kind": "http", "langs": ["py"], "pattern": "\\b(requests|httpx)\\.(get|post|put)\\(|urlopen\\(", "hints": ["requests.", "httpx.", "urlopen("]},
    {"id": "hotjar", "kind": "replay", "vendor": "Hotjar", "langs": ["js", "ts", "html"], "pattern": "\\bhj\\(|static\\.hotjar\\.com", "hints": ["hj(", "static.hotjar.com"]},
    {"id": "fullstory", "kind": "replay", "vendor": "FullStory", "langs": ["js", "ts", "html"], "pattern": "\\bFS\\.(identify|init)|fullstory\\.com/s/fs\\.js", "hints": ["FS.", "fullstory.com/s/fs.js"]},
    {"id": "logrocket", "kind": "replay", "vendor": "LogRocket", "langs": ["js", "ts", "html"], "pattern": "\\bLogRocket\\.(init|identify)\\(", "hints": ["LogRocket."]},
    {"id": "clarity", "kind": "replay", "vendor": "Microsoft Clarity", "langs": ["js", "ts", "html"], "pattern": "\\bclarity\\(", "hints": ["clarity("]},
    {"id": "replay-masking-off", "kind": "replay", "langs": ["js", "ts", "html"], "pattern": "(maskAllInputs|maskInputs|maskAllText|inputMasking)\\s*:\\s*false|data-(hj|fs)-unmask|defaultPrivacyLevel\\s*:\\s*['\"]allow['\"]|data-dd-privacy=[\"']allow[\"']", "hints": ["maskAllInputs", "maskInputs", "maskAllText", "inputMasking", "-unmask", "defaultPrivacyLevel", "data-dd-privacy"]},
    {"id": "sentry-user", "kind": "error_tracker", "vendor": "Sentry", "langs": ["js", "ts", "html", "py"], "pattern": "Sentry\\.setUser\\(|sentry_sdk\\.set_user\\(", "hints": ["Sentry.setUser(", "sentry_sdk.set_user("]},
    {"id": "default-pii", "kind": "error_tracker", "langs": ["js", "ts", "html", "py"], "pattern": "(sendDefaultPii|send_default_pii)\\s*[:=]\\s*(true|True|false|False)", "hints": ["sendDefaultPii", "send_default_pii"]},
    {"id": "local-storage", "kind": "storage", "langs": ["js", "ts", "html"], "pattern": "\\b(localStorage|sessionStorage)\\.setItem\\(", "hints": ["localStorage.setItem(", "sessionStorage.setItem("]},
    {"id": "js-cookie", "kind": "storage", "langs": ["js", "ts", "html"], "pattern": "document\\.cookie\\s*=", "hints": ["document.cookie"]},
    {"id": "py-cookie", "kind": "storage", "langs": ["py"], "pattern": "set_cookie\\(|Set-Cookie", "hints": ["set_cookie(", "Set-Cookie"]},
    {"id": "android-prefs", "kind": "storage", "langs": ["java", "kt"], "pattern": "getSharedPreferences\\(|\\.putString\\(", "hints": ["getSharedPreferences(", ".putString("]},
    {"id": "ios-defaults", "kind": "storage", "langs": ["swift", "m"], "pattern": "UserDefaults\\.standard\\.set\\(", "hints": ["UserDefaults.standard.set("]},
    {"id": "datadog-logs", "kind": "log", "vendor": "Datadog", "pattern": "\\b(datadogLogs|DD_LOGS)\\.logger\\.(debug|info|warn|error|log)\\(", "langs": ["js", "ts", "html"], "hints": ["datadogLogs.logger.", "DD_LOGS.logger."]},
    {"id": "datadog-rum-init", "kind": "replay", "vendor": "Datadog", "pattern": "\\b(datadogRum|DD_RUM)\\.init\\(", "langs": ["js", "ts", "html"], "hints": ["datadogRum.init(", "DD_RUM.init("]},
    {"id": "indexeddb", "kind": "storage", "pattern": "\\bindexedDB\\.open\\(|\\bnew Dexie\\(|\\bidb(Keyval)?\\.set\\(|\\bopenDB\\(", "langs": ["js", "ts", "html"], "hints": ["indexedDB.open(", "new Dexie(", "idb.set(", "idbKeyval.set(", "openDB("]},
    {"id": "localforage", "kind": "storage", "pattern": "\\blocalforage\\.(setItem|config|createInstance)\\(", "langs": ["js", "ts", "html"], "hints": ["localforage."]},
    {"id": "auth-token-storage", "kind": "storage", "pattern": "\\bcacheLocation\\s*:\\s*(?:['\"`](?:localStorage|sessionStorage|localstorage)['\"`]|(?:msal\\.)?BrowserCacheLocation\\.(?:LocalStorage|SessionStorage))|\\bstoreAuthStateInCookie\\s*:\\s*true|\\buserStore\\s*:\\s*new\\s+(?:\\w+\\.)?WebStorageStateStore\\(\\s*\\{\\s*store\\s*:\\s*(?:window\\.)?(?:localStorage|sessionStorage)", "langs": ["js", "ts", "html"], "hints": ["cacheLocation", "storeAuthStateInCookie", "WebStorageStateStore"]},
    {"id": "auth-sdk-init", "kind": "storage", "pattern": "\\bnew\\s+(?:msal\\.|\\w+\\.)?(?:PublicClientApplication|UserManager)\\(|\\bcreateStandardPublicClientApplication\\(", "langs": ["js", "ts", "html"], "hints": ["PublicClientApplication", "UserManager("]},
    {"id": "cache-persist", "kind": "storage", "pattern": "\\b(persistCache|CachePersistor|persistQueryClient|createSyncStoragePersister|createAsyncStoragePersister|persistStore)\\(|\\bnew (CachePersistor|LocalForageWrapper|LocalStorageWrapper|SessionStorageWrapper|IonicStorageWrapper)\\(", "langs": ["js", "ts", "html"], "hints": ["persistCache(", "CachePersistor", "persistQueryClient(", "createSyncStoragePersister(", "createAsyncStoragePersister(", "persistStore(", "new LocalForageWrapper(", "new LocalStorageWrapper(", "new SessionStorageWrapper(", "new IonicStorageWrapper("]}
  ],
  "collection_hints": {"html_input": ["<input", "<select", "<textarea"], "py_form_read": ["form.get(", "form[", "args.get(", "args[", "values.get(", "values[", "json.get(", "json[", "data.get(", "data[", "GET.get(", "GET[", "POST.get(", "POST[", "body.get(", "body[", "query.get(", "query[", "params.get(", "params[", "Data.get(", "Data[", "fields.get(", "fields["], "js_value_read": [").value"], "js_register": ["register(", "useField(", "getFieldProps("]},
  "collection": {
    "html_input": "<(input|select|textarea)\\b[^>]*>",
    "py_form_read": "(\\brequest\\.(form|args|values|json|data|GET|POST)|\\b(req|request|ctx\\.request)\\.(body|query|params)|\\bform|\\bform_data|\\bformData|\\bcleaned_data|\\bfields|\\bparams)(\\.get\\(|\\[)\\s*['\"](?P<name>[\\w-]+)['\"]",
    "js_value_read": "(getElementById|querySelector)\\(['\"]#?(?P<name>[\\w-]+)['\"]\\)\\.value",
    "jsx_input": "<(input|select|textarea|TextField|Input|OutlinedInput|FilledInput|Select|NativeSelect|Autocomplete|TextareaAutosize|DatePicker|DateTimePicker|PhoneInput|Field)\\b",
    "js_register": "\\b(register|useField|getFieldProps)\\(\\s*['\"](?P<name>[\\w.-]+)['\"]",
    "identity_read": "\\b(?P<name>idTokenClaims|idToken|rawIdToken|id_token|accessToken|access_token)\\b|\\b(?:account|activeAccount|idTokenClaims|claims)\\??\\.(?P<claim>username|preferred_username|upn|email|name|oid|given_name|family_name)\\b",
    "token_alias": "\\b(?:const|let|var)\\s+(?P<var>\\w+)\\s*=\\s*(?:await\\s+)?(?:(?:jwtDecode|jwt_decode|decodeJwt|parseJwt|decodeToken)\\(|JSON\\.parse\\(\\s*(?:window\\.)?atob\\(|(?:window\\.)?(?:sessionStorage|localStorage)\\.getItem\\([^)\\n]*(?:[Tt]oken|msal|MSAL|auth|oidc))",
    "file_input": "\\bXLSX\\.(?:read|readFile)\\(|\\bxlsx\\.read\\(|\\bPapa\\.parse\\(|\\bnew FileReader\\(|\\.readAs(?:ArrayBuffer|Text|BinaryString|DataURL)\\(|\\buseDropzone\\(|\\brequest\\.files\\b|\\bUploadFile\\b",

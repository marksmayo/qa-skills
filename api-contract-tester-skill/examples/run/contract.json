  "root": {
    "openapi": "3.1.0",
    "info": {
      "title": "Clinic API",
      "version": "1.5.0",
      "description": "Appointment booking for a small clinic. All data in examples is invented."
    },
    "servers": [
      {
        "url": "http://127.0.0.1:8140"
      }
    ],
    "components": {
      "securitySchemes": {
        "bearer": {
          "type": "http",
          "scheme": "bearer"
        }
      },
      "responses": {
        "Unauthorised": {
          "description": "Missing or wrong bearer token",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "BadRequest": {
          "description": "The request was invalid",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      },
      "schemas": {
        "Error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "Specialty": {
          "type": "string",
          "enum": [
            "gp",
            "physio",
            "dental"
          ]
        },
        "Clinician": {
          "type": "object",
          "required": [
            "id",
            "name",
            "specialty"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "specialty": {
              "$ref": "#/components/schemas/Specialty"
            }
          },
          "example": {
            "id": "c-7",
            "name": "Dr Example",
            "specialty": "gp"
          }
        },
        "Appointment": {
          "type": "object",
          "required": [
            "id",
            "clinic_id",
            "clinician_id",
            "date",
            "time",
            "status"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "clinic_id": {
              "type": "integer"
            },
            "clinician_id": {
              "type": "integer"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "status": {
              "type": "string",
              "enum": [
                "booked",
                "cancelled",
                "no_show"
              ]
            },
            "patient_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "NewAppointment": {
          "type": "object",
          "required": [
            "patient_name",
            "clinician_id",
            "date",
            "time"
          ],
          "additionalProperties": false,
          "properties": {
            "patient_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "clinician_id": {
              "type": "integer",
              "minimum": 1
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "portal_pin": {
              "type": "string",
              "format": "password",
              "writeOnly": true,
              "pattern": "^[0-9]{4}$"
            }
          }
        },
        "Report": {
          "type": "object",
          "required": [
            "date",
            "booked",
            "cancelled"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "booked": {
              "type": "integer",
              "minimum": 0
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0
            },
            "no_show": {
              "type": "integer"
            }
          },
          "dependentRequired": {
            "no_show": [
              "booked"
            ]
          }
        },
        "Slot": {
          "type": "object",
          "required": [
            "time",
            "free"
          ],
          "properties": {
            "time": {
              "type": "string"
            },
            "free": {
              "type": "boolean"
            }
          }
        }
      }
    },

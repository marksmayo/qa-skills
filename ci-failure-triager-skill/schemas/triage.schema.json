{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/qa-skills/ci-failure-triager/triage.schema.json",
 "title": "CI failure triage",
 "type": "object",
 "required": [
  "schema_version",
  "skill",
  "generated_at",
  "run",
  "run_status",
  "reruns",
  "failures",
  "summary",
  "limitations",
  "files_written"
 ],
 "properties": {
  "schema_version": {
   "enum": [
    "1.2.0",
    "1.3.0",
    "1.4.0"
   ],
   "description": "1.3.0 and 1.4.0 add optional fields only (1.4.0: failure groups, one draft per group, checks_not_run, summary.evidence_checks, which a 1.4.0 triage must carry when the run has them); 1.2.0 and 1.3.0 reports still validate"
  },
  "skill": {
   "type": "object",
   "required": [
    "name",
    "version"
   ],
   "properties": {
    "name": {
     "const": "ci-failure-triager"
    },
    "version": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "generated_at": {
   "type": "string",
   "minLength": 10
  },
  "run": {
   "type": "object",
   "required": [
    "system",
    "id",
    "attempt",
    "commit",
    "branch",
    "started_at",
    "last_green",
    "source"
   ],
   "properties": {
    "system": {
     "enum": [
      "github",
      "azure"
     ]
    },
    "source": {
     "enum": [
      "live",
      "recorded"
     ]
    },
    "repo": {
     "type": "string",
     "description": "the repository as requested"
    },
    "repo_api": {
     "type": "string",
     "description": "the name the CI API gives it, when different (renamed or transferred)"
    },
    "last_green": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "id",
      "commit"
     ],
     "description": "the newest successful run of the same workflow on the branch before this run; when the branch has none, the newest on the default branch (branch names it, basis says so), whose commit then starts the range of changes",
     "properties": {
      "branch": {
       "type": "string"
      },
      "basis": {
       "type": "string"
      }
     }
    },
    "fetch_problems": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "kind",
       "status"
      ],
      "properties": {
       "kind": {
        "enum": [
         "log",
         "artifact",
         "annotations"
        ]
       },
       "status": {
        "enum": [
         "unavailable",
         "fetch_failed",
         "skipped",
         "partial"
        ]
       }
      }
     }
    }
   }
  },
  "run_status": {
   "enum": [
    "complete",
    "partial",
    "not_run"
   ],
   "description": "not_run: the run concluded without running any job (a workflow file error, a startup failure, a fork pull request never approved), so there is nothing to triage and the headline says so; partial: the log of a failed job could not be downloaded; recomputed by the validator"
  },
  "run_status_reason": {
   "type": "string",
   "minLength": 10,
   "description": "required unless run_status is complete"
  },
  "reruns": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "run_id",
     "from_attempt",
     "new_attempt",
     "jobs_rerun",
     "jobs_failed_before",
     "authorised_by",
     "mode",
     "at",
     "outcomes"
    ],
    "properties": {
     "mode": {
      "enum": [
       "live",
       "recorded",
       "observed"
      ]
     },
     "authorised_by": {
      "type": [
       "string",
       "null"
      ]
     },
     "triggered_by": {
      "type": "string",
      "description": "observed: who started the re-run (the run's triggering actor)"
     }
    },
    "if": {
     "properties": {
      "mode": {
       "const": "observed"
      }
     }
    },
    "then": {
     "required": [
      "triggered_by"
     ],
     "properties": {
      "authorised_by": {
       "type": "null"
      }
     }
    },
    "else": {
     "properties": {
      "authorised_by": {
       "type": "string",
       "minLength": 3
      }
     }
    }
   }
  },
  "failures": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "job",
     "step",
     "kind",
     "test_id",
     "message",
     "classification",
     "confidence",
     "rule",
     "signals",
     "log_excerpt",
     "owning_change",
     "priority",
     "next_action"
    ],
    "properties": {
     "kind": {
      "enum": [
       "test",
       "step"
      ]
     },
     "source": {
      "enum": [
       "junit",
       "console",
       "log"
      ]
     },
     "classification": {
      "enum": [
       "real",
       "flaky",
       "environment",
       "data",
       "consequence",
       "unclassified"
      ]
     },
     "confidence": {
      "enum": [
       "confirmed",
       "indicated",
       "low"
      ]
     },
     "override_reason": {
      "type": "string",
      "minLength": 20
     },
     "priority": {
      "enum": [
       "P0",
       "P1",
       "P2",
       null
      ]
     },
     "signals": {
      "type": "object",
      "required": [
       "signatures",
       "date_markers",
       "rerun",
       "step_kind"
      ],
      "properties": {
       "rerun": {
        "enum": [
         "passed",
         "failed",
         "missing",
         "not_rerun",
         "job_not_rerun",
         "skipped"
        ]
       },
       "step_kind": {
        "enum": [
         "test",
         "setup",
         "other"
        ]
       },
       "consequence_of": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "log_status": {
        "enum": [
         "fetched",
         "unavailable",
         "fetch_failed",
         "not_requested",
         "partial",
         "missing",
         "never_started"
        ]
       },
       "annotations": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "the job's check-run annotations as the run recorded them (the CI's own explanation, such as a job not started because of a billing or spending-limit stop): quoted, untrusted text, checked against the run"
       },
       "local_runs": {
        "type": [
         "object",
         "null"
        ],
        "description": "local repeat runs of this test on the failing commit (local_runs.json, recorded by the agent): records, runs, failed"
       },
       "local_flaky": {
        "type": "boolean",
        "description": "the local repeat runs on the failing commit both passed and failed"
       },
       "queued_for_s": {
        "type": "integer",
        "minimum": 0,
        "description": "a job that never started on a runner: the seconds between its start and completion, time spent waiting for a runner, never time running (checked against the run)"
       }
      }
     },
     "log_excerpt": {
      "type": "object",
      "required": [
       "path",
       "lines"
      ],
      "properties": {
       "lines": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "n",
          "text"
         ]
        }
       }
      }
     },
     "owning_change": {
      "type": "object",
      "required": [
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "identified",
         "not_identified"
        ]
       },
       "commit": {
        "type": "string"
       },
       "files_shared": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "file",
          "why"
         ]
        }
       },
       "ties": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "other commits in range with the same score; the owner is the newest of the tied commits, and the report names the ties"
       },
       "override_reason": {
        "type": "string",
        "minLength": 20
       }
      }
     },
     "draft_defect": {
      "type": [
       "object",
       "null"
      ],
      "required": [
       "kind",
       "title",
       "body"
      ],
      "properties": {
       "kind": {
        "enum": [
         "defect",
         "test_data_issue"
        ]
       },
       "body": {
        "type": "object",
        "required": [
         "summary",
         "steps",
         "expected",
         "actual",
         "evidence"
        ],
        "properties": {
         "summary": {
          "type": "string",
          "minLength": 1
         },
         "steps": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "expected": {
          "type": "string"
         },
         "actual": {
          "type": "string"
         },
         "evidence": {
          "type": "array",
          "items": {
           "type": "string"
          }
         }
        }
       },
       "title": {
        "type": "string",
        "minLength": 5
       },
       "covers": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "ids of the other failures of the same group (same classification) this draft also covers"
       }
      },
      "description": "one draft per defect: for a failure group the draft sits on one member and covers lists the group's other failures it stands for"
     },
     "test_id_source": {
      "enum": [
       "extractor",
       "agent"
      ],
      "description": "agent: the extractor read no test for this step failure and the agent names it from the log lines it quotes (the validator checks they show it); kind is then test"
     },
     "failure_type": {
      "type": [
       "string",
       "null"
      ],
      "description": "assertion, error or timeout for a test; for a step failure compile, lint, format or coverage_gate when its excerpt carries that real signature, else step; job for a job with no failed step"
     },
     "id": {
      "type": "string",
      "minLength": 1
     },
     "group": {
      "type": "string",
      "description": "the failure group this failure belongs to (failure_groups): one defect seen on several jobs, such as the legs of a matrix; recomputed by the validator"
     },
     "next_action": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "summary": {
   "type": "object",
   "required": [
    "headline",
    "by_classification",
    "defects_drafted",
    "reruns",
    "evidence_completeness"
   ],
   "properties": {
    "headline": {
     "type": "string",
     "minLength": 10
    },
    "by_classification": {
     "type": "object"
    },
    "defects_drafted": {
     "type": "integer",
     "minimum": 0
    },
    "reruns": {
     "type": "integer",
     "minimum": 0
    },
    "evidence_completeness": {
     "type": "number",
     "minimum": 0
    },
    "evidence_checks": {
     "type": "object",
     "description": "the five checks behind evidence_completeness, each true, false or \"not_applicable\" (scores 0: nothing to check, such as test results when no test step failed): logs, test_results, rerun, last_green, repository; recomputed by the validator"
    }
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "files_written": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "failure_groups": {
   "type": "array",
   "description": "failures that are one defect on several jobs (extract_failures.py groups); every member keeps its own evidence and one draft covers the group; recomputed by the validator",
   "items": {
    "type": "object",
    "required": [
     "id",
     "failures",
     "jobs",
     "basis"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "failures": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "jobs": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "basis": {
      "type": "string"
     }
    }
   }
  },
  "checks_not_run": {
   "type": "object",
   "required": [
    "steps",
    "jobs"
   ],
   "description": "what the failures kept from running (extract_failures.py checks_not_run): steps skipped after a job's first failed step, and skipped jobs; they gave no result on this commit; recomputed by the validator",
   "properties": {
    "steps": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "job",
       "after_step",
       "steps"
      ]
     }
    },
    "jobs": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "run_status": {
      "enum": [
       "partial",
       "not_run"
      ]
     }
    },
    "required": [
     "run_status"
    ]
   },
   "then": {
    "required": [
     "run_status_reason"
    ]
   }
  }
 ]
}

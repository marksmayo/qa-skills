{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/ci-failure-triager/triage.schema.json",
  "title": "CI failure triage",
  "type": "object",
  "required": ["schema_version", "skill", "generated_at", "run", "reruns", "failures", "summary", "limitations", "files_written"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "ci-failure-triager"}}},
    "generated_at": {"type": "string"},
    "run": {"type": "object", "required": ["system", "id", "attempt", "commit", "branch", "started_at", "last_green", "source"],
      "properties": {"system": {"enum": ["github", "azure"]}, "source": {"enum": ["live", "recorded"]},
                     "last_green": {"type": ["object", "null"], "required": ["id", "commit"]}}},
    "reruns": {"type": "array", "items": {"type": "object",
      "required": ["run_id", "from_attempt", "new_attempt", "jobs_rerun", "jobs_failed_before", "authorised_by", "mode", "at", "outcomes"],
      "properties": {"mode": {"enum": ["live", "recorded"]}, "authorised_by": {"type": "string", "minLength": 3}}}},
    "failures": {"type": "array", "items": {"type": "object",
      "required": ["id", "job", "step", "kind", "test_id", "message", "classification", "confidence", "rule", "signals", "log_excerpt", "owning_change", "priority", "next_action"],
      "properties": {
        "kind": {"enum": ["test", "step"]},
        "classification": {"enum": ["real", "flaky", "environment", "data", "unclassified"]},
        "confidence": {"enum": ["confirmed", "indicated", "low"]},
        "override_reason": {"type": "string", "minLength": 20},
        "priority": {"enum": ["P0", "P1", "P2", null]},
        "signals": {"type": "object", "required": ["signatures", "date_markers", "rerun", "step_kind"],
          "properties": {"rerun": {"enum": ["passed", "failed", "missing", "not_rerun", "job_not_rerun", "skipped"]}}},
        "log_excerpt": {"type": "object", "required": ["path", "lines"],
          "properties": {"lines": {"type": "array", "items": {"type": "object", "required": ["n", "text"]}}}},
        "owning_change": {"type": "object", "required": ["status"],
          "properties": {"status": {"enum": ["identified", "not_identified"]}, "commit": {"type": "string"},
                         "files_shared": {"type": "array", "items": {"type": "object", "required": ["file", "why"]}}}},
        "draft_defect": {"type": "object", "required": ["kind", "title", "body"],
          "properties": {"kind": {"enum": ["defect", "test_data_issue"]},
                         "body": {"type": "object", "required": ["summary", "steps", "expected", "actual", "evidence"]}}}}}},
    "summary": {"type": "object", "required": ["headline", "by_classification", "defects_drafted", "reruns", "evidence_completeness"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "files_written": {"type": "array", "items": {"type": "string"}}
  }
}

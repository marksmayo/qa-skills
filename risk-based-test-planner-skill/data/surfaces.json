        "\\b(log_?in|sign_?in|authenticate|authori[sz]e|has_?permission|check_?permission|require_?(role|auth|user|admin|login)|verify_?password|check_?password|ensure_?authenticated|with_?auth)(_\\w+)?\\s*\\(",

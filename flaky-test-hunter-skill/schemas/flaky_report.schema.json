{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marksmayo/qa-skills/flaky-test-hunter/flaky_report.schema.json",
  "title": "Flaky test report",
  "description": "Output of the flaky-test-hunter skill. Per-test run counts with Wilson intervals, each flake's cause and the experiment behind it, proposed fixes, and every static smell accounted for. Never claims a test or suite is not flaky.",
  "type": "object",
  "required": ["schema_version", "skill", "generated_at", "metadata", "tools", "variations", "tests", "flakes",
               "consistently_failing", "static_smells", "summary", "limitations", "files_changed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "skill": {"type": "object", "required": ["name", "version"], "additionalProperties": false,
              "properties": {"name": {"const": "flaky-test-hunter"}, "version": {"type": "string"}}},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "metadata": {
      "type": "object",
      "required": ["repo", "code_hash", "framework", "run_command", "runs_file", "budget", "gate", "critical_tests",
                   "platform"],
      "additionalProperties": false,
      "properties": {
        "repo": {"type": "string"},
        "commit": {"type": ["string", "null"]},
        "code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "framework": {"type": "string"},
        "run_command": {"type": "string"},
        "runs_file": {"type": "string"},
        "platform": {"type": "string"},
        "budget": {"type": "object", "required": ["repeats", "minutes", "stopped_early"], "additionalProperties": false,
                   "properties": {"repeats": {"type": "integer", "minimum": 1}, "minutes": {"type": "number"},
                                  "stopped_early": {"type": "boolean"}}},
        "gate": {"type": "object", "required": ["level", "evidence"], "additionalProperties": false,
                 "properties": {"level": {"enum": ["required", "ci", "local"]}, "evidence": {"type": "string", "minLength": 1}}},
        "critical_tests": {"type": "array", "items": {"type": "string"}},
        "history": {"type": "object", "required": ["status", "source"], "additionalProperties": false,
                    "properties": {"status": {"enum": ["used", "not_given"]}, "source": {"type": ["string", "null"]}}}
      }
    },
    "tools": {"type": "array", "items": {
      "type": "object", "required": ["name", "version", "status", "reason"], "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]},
                     "status": {"enum": ["ran", "not_run", "errored"]}, "reason": {"type": "string"}}}},
    "variations": {"type": "array", "items": {
      "type": "object", "required": ["kind", "status", "labels", "reason"], "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["repeat", "order", "isolate", "seed", "parallel", "tz", "clock", "locale", "cpu_load", "latency", "race", "platform"]},
        "status": {"enum": ["ran", "not_run", "not_applicable"]},
        "labels": {"type": "array", "items": {"type": "string"}},
        "tool": {"type": "string"},
        "scope": {"type": "string"},
        "reason": {"type": "string"}
      }}},
    "tests": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "file", "runs", "passes", "fails", "normal", "worst", "by_label", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "file": {"type": ["string", "null"]},
        "runs": {"type": "integer"}, "passes": {"type": "integer"}, "fails": {"type": "integer"},
        "normal": {"$ref": "#/$defs/rate"},
        "worst": {"type": "object", "required": ["label", "runs", "fails", "wilson_low"], "additionalProperties": false,
                  "properties": {"label": {"type": ["string", "null"]}, "runs": {"type": "integer"},
                                 "fails": {"type": "integer"}, "wilson_low": {"type": "number"}}},
        "by_label": {"type": "array", "items": {"type": "object", "required": ["label", "runs", "fails"],
                     "additionalProperties": false,
                     "properties": {"label": {"type": "string"}, "runs": {"type": "integer"}, "fails": {"type": "integer"}}}},
        "status": {"enum": ["flaky", "consistently_failing", "platform_dependent", "not_observed_flaky", "not_run"]},
        "by_platform": {"type": "array", "description": "per platform, only when the runs name more than one platform",
                        "items": {"type": "object", "required": ["platform", "runs", "fails"], "additionalProperties": false,
                                  "properties": {"platform": {"type": "string"}, "runs": {"type": "integer"},
                                                 "fails": {"type": "integer"}}}}
      }}},
    "flakes": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "test_id", "cause", "cause_confidence", "experiment", "evidence_runs", "polluter",
                   "failure_excerpts", "rate_factor", "gate", "masking", "score", "priority", "priority_note", "fix",
                   "quarantine"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^FL-\\d+$"},
        "test_id": {"type": "string"},
        "cause": {"enum": ["async_wait", "shared_state", "order_dependence", "external_dependency", "time_and_locale",
                           "randomness", "resource_contention", "product_race", "unknown"]},
        "cause_confidence": {"enum": ["confirmed", "indicated", "suspected"]},
        "experiment": {"type": "object", "required": ["run_ids", "what_changed", "result"], "additionalProperties": false,
                       "properties": {"run_ids": {"type": "array", "items": {"type": "string"}},
                                      "what_changed": {"type": "string", "minLength": 1},
                                      "result": {"type": "string", "minLength": 1}}},
        "evidence_runs": {"type": "object", "required": ["passing", "failing"], "additionalProperties": false,
                          "properties": {"passing": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                                         "failing": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
        "polluter": {"type": ["object", "null"], "required": ["test_id", "bisect_run_ids", "pair_run_id", "alone_run_id"],
                     "additionalProperties": false,
                     "properties": {"test_id": {"type": "string"},
                                    "relation": {"enum": ["polluter", "enabler"]},
                                    "bisect_run_ids": {"type": "array", "items": {"type": "string"}},
                                    "pair_run_id": {"type": "string"}, "alone_run_id": {"type": "string"}}},
        "failure_excerpts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rate_factor": {"type": "integer", "minimum": 1, "maximum": 4},
        "gate": {"type": "integer", "minimum": 1, "maximum": 3},
        "masking": {"type": "integer", "minimum": 1, "maximum": 2},
        "score": {"type": "integer"},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "priority_note": {"type": "string"},
        "history_only": {"type": "boolean"},
        "history_evidence": {"type": "array", "minItems": 1,
          "description": "for a history_only flake: the CI runs (or logs) that passed and failed; evidence_runs name these ids",
          "items": {"type": "object", "required": ["id", "source", "ref", "outcome", "excerpt"], "additionalProperties": false,
                    "properties": {"id": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1},
                                   "ref": {"type": "string", "minLength": 1}, "outcome": {"enum": ["pass", "fail"]},
                                   "excerpt": {"type": "string"}}}},
        "fix": {"type": "object", "required": ["diff", "rationale", "applied", "verification_run_ids"],
                "additionalProperties": false,
                "properties": {"diff": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1},
                               "applied": {"type": "boolean"},
                               "verification_run_ids": {"type": "array", "items": {"type": "string"}}}},
        "quarantine": {"type": ["object", "null"], "required": ["how", "owner", "ticket", "applied"],
                       "additionalProperties": false,
                       "properties": {"how": {"type": "string"}, "owner": {"type": "string"},
                                      "ticket": {"type": "string"}, "applied": {"const": false}}}
      }}},
    "consistently_failing": {"type": "array", "items": {
      "type": "object", "required": ["test_id", "runs", "failure_excerpt", "note"], "additionalProperties": false,
      "properties": {"test_id": {"type": "string"}, "runs": {"type": "integer"},
                     "platforms": {"type": "array", "items": {"type": "string"},
                                   "description": "for a platform_dependent test: the platforms it failed on in every run"},
                     "failure_excerpt": {"type": "string"}, "note": {"type": "string", "minLength": 1}}}},
    "static_smells": {"type": "array", "items": {
      "type": "object", "required": ["smell_id", "smell", "file", "line", "test", "cause", "status", "flake_id", "note"],
      "additionalProperties": false,
      "properties": {"smell_id": {"type": "string"}, "smell": {"type": "string"}, "file": {"type": "string"},
                     "line": {"type": "integer"}, "test": {"type": ["string", "null"]}, "cause": {"type": "string"},
                     "status": {"enum": ["linked_to_flake", "not_observed", "linked_to_failure"]},
                     "flake_id": {"type": ["string", "null"]}, "note": {"type": "string"}}}},
    "summary": {
      "type": "object",
      "required": ["headline", "tests_run", "flaky", "consistently_failing", "not_observed_flaky", "not_run", "by_cause",
                   "by_priority", "total_runs", "wall_minutes", "evidence_completeness"],
      "additionalProperties": false,
      "properties": {
        "headline": {"type": "string", "minLength": 1},
        "tests_run": {"type": "integer"}, "flaky": {"type": "integer"}, "consistently_failing": {"type": "integer"},
        "not_observed_flaky": {"type": "integer"}, "not_run": {"type": "integer"},
        "platform_dependent": {"type": "integer"},
        "by_cause": {"type": "object"}, "by_priority": {"type": "object"},
        "total_runs": {"type": "integer"}, "wall_minutes": {"type": "number"},
        "evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "files_changed": {"type": "array", "items": {"type": "object", "required": ["path", "kind"], "additionalProperties": false,
                      "properties": {"path": {"type": "string"}, "kind": {"enum": ["test", "fixture", "config"]}}}}
  },
  "$defs": {
    "rate": {"type": "object", "required": ["runs", "fails", "rate", "wilson_low", "wilson_high"], "additionalProperties": false,
             "properties": {"runs": {"type": "integer"}, "fails": {"type": "integer"}, "rate": {"type": ["number", "null"]},
                            "wilson_low": {"type": "number"}, "wilson_high": {"type": "number"}}}
  }
}

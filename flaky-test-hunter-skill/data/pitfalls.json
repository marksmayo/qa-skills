{
 "version": "1.0.0",
 "notes": "Static flake smells in test code. A match is a lead, never a flake: it becomes a flake only when runs show a pass and a fail. Patterns are line regexes applied to test files of the listed languages; 'cause' is the cause class the smell usually leads to, and 'fix' the usual remedy. Comment lines are skipped.",
 "smells": [
  {"id": "fixed-sleep", "languages": ["python"], "pattern": "\\btime\\.sleep\\(\\s*[0-9.]+\\s*\\)|\\bsleep\\(\\s*[0-9.]+\\s*\\)", "cause": "async_wait", "message": "Fixed sleep in a test", "fix": "Wait on the condition with a deadline (an Event, thread.join(timeout), or a polling helper), not on time."},
  {"id": "fixed-sleep-js", "languages": ["javascript", "typescript"], "pattern": "\\bsetTimeout\\s*\\(|\\bwaitForTimeout\\s*\\(|\\bcy\\.wait\\(\\s*\\d+|new Promise\\(\\s*\\(?r(?:esolve)?\\)?\\s*=>\\s*setTimeout", "cause": "async_wait", "message": "Fixed delay in a test", "fix": "Use the framework's waiting assertions (expect.poll, toPass, findBy*, waitFor) on the state you need."},
  {"id": "fixed-sleep-jvm", "languages": ["java", "kotlin"], "pattern": "\\bThread\\.sleep\\s*\\(|\\bSystemClock\\.sleep\\s*\\(", "cause": "async_wait", "message": "Fixed sleep in a test", "fix": "Use Awaitility, CountDownLatch.await(timeout) or Espresso idling resources."},
  {"id": "fixed-sleep-go", "languages": ["go"], "pattern": "\\btime\\.Sleep\\s*\\(", "cause": "async_wait", "message": "Fixed sleep in a test", "fix": "Synchronise on a channel or sync.WaitGroup with a timeout."},
  {"id": "wall-clock-today", "languages": ["python"], "pattern": "\\bdate\\.today\\(\\)|\\bdatetime\\.(?:now|today)\\(\\s*\\)|\\btime\\.localtime\\(", "cause": "time_and_locale", "message": "Local wall-clock read in a test", "fix": "Freeze the clock (the repo's clock helper, freezegun or time-machine) or compare in UTC on both sides."},
  {"id": "wall-clock-js", "languages": ["javascript", "typescript"], "pattern": "new Date\\(\\s*\\)|\\bDate\\.now\\(\\)", "cause": "time_and_locale", "message": "Wall-clock read in a test", "fix": "Use fake timers (vi.useFakeTimers, jest.useFakeTimers) with setSystemTime, or inject a clock."},
  {"id": "wall-clock-jvm", "languages": ["java", "kotlin"], "pattern": "\\b(?:LocalDate|LocalDateTime|ZonedDateTime)\\.now\\(\\s*\\)|new Date\\(\\s*\\)|System\\.currentTimeMillis\\(", "cause": "time_and_locale", "message": "Wall-clock read in a test", "fix": "Inject a java.time.Clock and use Clock.fixed in tests."},
  {"id": "unseeded-random", "languages": ["python"], "pattern": "\\brandom\\.(?:random|randint|choice|shuffle|sample)\\(|\\bFaker\\(\\s*\\)|\\buuid\\.uuid4\\(", "cause": "randomness", "message": "Unseeded randomness in a test", "fix": "Seed it (random.Random(seed), Faker.seed) and record the seed, or assert on properties instead of values."},
  {"id": "unseeded-random-js", "languages": ["javascript", "typescript"], "pattern": "\\bMath\\.random\\(|\\bfaker\\.(?!seed)|crypto\\.randomUUID\\(", "cause": "randomness", "message": "Unseeded randomness in a test", "fix": "Seed faker (faker.seed) or stub Math.random."},
  {"id": "set-order", "languages": ["python"], "pattern": "\\blist\\(\\s*(?:set\\(|\\{|[a-z_]*(?:allocate|seats|tags|ids|keys)\\w*\\()[^)]*\\)\\s*\\)?\\s*==|==\\s*list\\(\\s*set\\(", "cause": "randomness", "message": "Assertion on the order of a set", "fix": "Compare sets, or sort both sides."},
  {"id": "module-global-state", "languages": ["python"], "pattern": "^_?[A-Z_]{3,}\\s*(?::[^=]+)?=\\s*(?:\\{\\}|\\[\\]|dict\\(\\)|list\\(\\)|set\\(\\))", "cause": "shared_state", "message": "Module-level mutable state", "fix": "Reset it in a fixture (autouse) or inject it, so tests don't depend on order.", "scope": "source"},
  {"id": "fixed-port", "languages": ["python", "javascript", "typescript", "java", "kotlin", "go"], "pattern": "(?:localhost|127\\.0\\.0\\.1)[:\"', ]+\\s*(?:[1-9]\\d{3,4})\\b|\\b(?:start|listen|bind|serve)\\w*\\(\\s*(?:[1-9]\\d{3,4})\\s*[,)]", "cause": "resource_contention", "message": "Fixed network port", "fix": "Bind port 0 and read the port the OS assigned."},
  {"id": "real-network", "languages": ["python"], "pattern": "requests\\.(?:get|post)\\(\\s*[\"']https?://(?!localhost|127\\.0\\.0\\.1)|urlopen\\(\\s*[\"']https?://(?!localhost|127\\.0\\.0\\.1)", "cause": "external_dependency", "message": "Real network call to an outside host", "fix": "Stub the HTTP client (responses, respx, pytest-httpserver) or record and replay."},
  {"id": "shared-temp-path", "languages": ["python"], "pattern": "[\"']/tmp/[\\w.-]+|tempfile\\.gettempdir\\(\\)\\s*\\+|os\\.path\\.join\\(\\s*tempfile\\.gettempdir\\(\\)", "cause": "resource_contention", "message": "Fixed temporary path shared between tests", "fix": "Use the tmp_path fixture or tempfile.mkdtemp per test."},
  {"id": "missing-await", "languages": ["javascript", "typescript"], "pattern": "^\\s*(?:page|locator|expect\\(page)\\.[a-zA-Z]+\\([^)]*\\)\\s*;?\\s*$", "cause": "async_wait", "message": "Playwright call without await", "fix": "await the call; enable @typescript-eslint/no-floating-promises."}
 ],
 "language_by_suffix": {".py": "python", ".js": "javascript", ".jsx": "javascript", ".mjs": "javascript", ".ts": "typescript", ".tsx": "typescript", ".java": "java", ".kt": "kotlin", ".go": "go"},
 "test_file_patterns": ["(^|/)tests?/", "(^|/)test_[^/]+\\.py$", "_test\\.(py|go)$", "\\.(test|spec)\\.[jt]sx?$", "(^|/)src/test/", "(^|/)__tests__/", "(^|/)e2e/", "Test\\.(java|kt)$"]
}

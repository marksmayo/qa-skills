{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Journey Map",
  "description": "Machine-readable result of a Journey Mapper run. scripts/validate_journey_map.py enforces this structure plus cross-field honesty checks (coverage arithmetic, evidence on every step, out_of_scope orphans outside the run scope, graph present or declined; with --repo, every cited file and line exists).",
  "type": "object",
  "required": ["metadata", "surface", "coverage", "journeys"],
  "oneOf": [{"required": ["graph"]}, {"required": ["graph_declined"]}],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "note": {"type": "string"},
        "excerpt": {"type": "string", "description": "Optional text from the cited line; with --repo the validator checks it is on that line."}
      }
    },
    "surfaceItem": {
      "type": "object",
      "required": ["id", "kind", "name", "file", "line", "confidence", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[RSENG]-\\d{3,}$"},
        "kind": {"enum": ["route", "screen", "endpoint", "entry_point", "goal"]},
        "name": {"type": "string", "minLength": 1},
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "detector": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "source": {"enum": ["extractor", "agent"]},
        "framework": {"type": "string"},
        "platform": {"type": "string"},
        "domain": {"type": "string"},
        "service": {"type": "string", "description": "The app or service the item belongs to, when the repository holds several (from the nearest project manifest). The proposed domain starts with it."},
        "index": {"type": "boolean", "description": "A client-side index route: it renders at its parent's path."},
        "note": {"type": "string"}
      }
    }
  },
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["repository", "generated_at", "platforms", "run_scope"],
      "properties": {
        "repository": {"type": "string"},
        "generated_at": {"type": "string"},
        "platforms": {"type": "array", "items": {"enum": ["web", "ios", "android", "desktop", "api", "cli"]}},
        "frameworks": {"type": "array", "items": {"type": "string"}},
        "run_scope": {
          "type": "object",
          "required": ["domains"],
          "properties": {
            "domains": {"oneOf": [{"const": "all"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]},
            "max_journeys": {"type": "integer", "minimum": 1}
          }
        },
        "extractor": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "surface": {
      "type": "object",
      "required": ["routes", "screens", "endpoints", "entry_points", "goals"],
      "properties": {
        "routes": {"type": "array", "items": {"$ref": "#/$defs/surfaceItem"}},
        "screens": {"type": "array", "items": {"$ref": "#/$defs/surfaceItem"}},
        "endpoints": {"type": "array", "items": {"$ref": "#/$defs/surfaceItem"}},
        "entry_points": {"type": "array", "items": {"$ref": "#/$defs/surfaceItem"}},
        "goals": {"type": "array", "items": {"$ref": "#/$defs/surfaceItem"}}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["surface_items_total", "in_journey", "orphans", "unreachable"],
      "properties": {
        "surface_items_total": {"type": "integer", "minimum": 0},
        "in_journey": {"type": "integer", "minimum": 0},
        "orphans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "reason"],
            "properties": {
              "item": {"type": "string"},
              "reason": {"enum": ["no_user_path_found", "not_user_facing", "out_of_scope", "not_mapped_this_run", "needs_review", "false_positive"]},
              "domain": {"type": "string", "description": "The domain the item belongs to, when it differs from the surface item's domain. out_of_scope needs a domain (here or on the item) outside run_scope.domains; not_mapped_this_run is for items inside it."},
              "note": {"type": "string", "description": "Required for not_mapped_this_run (the user path that was found) and needs_review (what a person must decide)."}
            }
          }
        },
        "unreachable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "reason", "evidence"],
            "properties": {
              "item": {"type": "string"},
              "reason": {"enum": ["dead", "flag_off", "guarded_unreachable"]},
              "evidence": {"$ref": "#/$defs/evidence"}
            }
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "domain", "platforms", "persona", "priority", "priority_reason",
                     "entry_point", "goal", "automation", "tests", "covers", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^JRN-[A-Z0-9]+-\\d{3}$"},
          "title": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "platforms": {"type": "array", "minItems": 1, "items": {"enum": ["web", "ios", "android", "desktop", "api", "cli"]}},
          "persona": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P1", "P2", "P3"]},
          "priority_reason": {"type": "string", "minLength": 1},
          "status": {"const": "inferred"},
          "entry_point": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "flags": {"type": "array", "items": {"type": "string"}},
          "automation": {"enum": ["none", "partial", "automated"]},
          "tests": {"type": "array", "items": {"type": "string"}},
          "covers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action", "expect", "evidence"],
              "properties": {
                "action": {"type": "string", "minLength": 1},
                "expect": {"type": "string", "minLength": 1},
                "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
              }
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "from_step", "expect"],
              "properties": {
                "id": {"type": "string", "pattern": "^V\\d+$"},
                "name": {"type": "string", "minLength": 1},
                "from_step": {"type": "integer", "minimum": 1},
                "action": {"type": "string"},
                "expect": {"type": "string", "minLength": 1},
                "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
              }
            }
          },
          "test_data": {"type": "array", "items": {"type": "string"}},
          "not_automatable": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "reason"],
              "properties": {
                "target": {"type": "string", "pattern": "^(step \\d+|V\\d+)$"},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "open_questions": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "kind"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "kind": {"enum": ["entry", "screen", "state", "goal"]},
              "domain": {"type": "string"},
              "platform": {"type": "string"},
              "surface_item": {"type": "string"},
              "file": {"type": "string"},
              "line": {"type": "integer"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "action"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "action": {"type": "string"},
              "guards": {"type": "array", "items": {"type": "string"}},
              "file": {"type": "string"},
              "line": {"type": "integer"}
            }
          }
        }
      }
    },
    "graph_declined": {
      "type": "string",
      "minLength": 1,
      "description": "Why the interaction graph was not built. Exactly one of graph and graph_declined must be present."
    },
    "open_questions": {
      "type": "array",
      "description": "Questions that span journeys or concern no single journey. A question about one journey goes in that journey's open_questions only; reports list each text once.",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "related": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "files": {
      "type": "array",
      "description": "Written by write_journeys.py",
      "items": {
        "type": "object",
        "required": ["path", "action"],
        "properties": {
          "path": {"type": "string"},
          "journey": {"type": "string"},
          "action": {"enum": ["created", "updated", "unchanged", "proposed", "stale", "generated"]}
        }
      }
    }
  }
}

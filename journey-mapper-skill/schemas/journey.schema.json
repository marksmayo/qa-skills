{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Journey Markdown front matter",
  "description": "Front matter of a Journey Markdown file (see JOURNEY_FORMAT.md). The file body is validated by scripts/journey_md.py lint.",
  "type": "object",
  "required": ["id", "title", "persona", "priority", "status", "entry_point", "goal"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^JRN-[A-Z0-9]+-\\d{3}$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "platforms": {
      "type": "array",
      "items": {"enum": ["web", "ios", "android", "desktop", "api", "cli"]},
      "uniqueItems": true
    },
    "persona": {"type": "string", "minLength": 1},
    "priority": {"enum": ["P1", "P2", "P3"]},
    "priority_reason": {"type": "string"},
    "status": {"enum": ["inferred", "reviewed", "approved"]},
    "entry_point": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "flags": {"type": "array", "items": {"type": "string"}},
    "automation": {"enum": ["none", "partial", "automated"]},
    "tests": {"type": "array", "items": {"type": "string"}}
  },
  "if": {"properties": {"automation": {"enum": ["partial", "automated"]}}, "required": ["automation"]},
  "then": {"properties": {"tests": {"minItems": 1}}, "required": ["tests"]}
}

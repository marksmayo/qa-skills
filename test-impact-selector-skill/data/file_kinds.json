{
  "$comment": "Globs (fnmatch, matched against the repo-relative POSIX path and, when a pattern has no '/', against the file name) that decide what a changed file is and how far a blind spot widens. select_tests.py reads this file; edit it to fit a repo, and the report records its SHA-256.",
  "lockfiles": ["pnpm-lock.yaml", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "bun.lockb", "poetry.lock", "uv.lock",
                "Pipfile.lock", "pdm.lock", "Cargo.lock", "go.sum", "gradle.lockfile", "*.lockfile", "Podfile.lock", "Package.resolved",
                "pubspec.lock", "composer.lock", "Gemfile.lock", "packages.lock.json"],
  "ci": [".github/workflows/*", ".github/actions/*", ".gitlab-ci.yml", ".gitlab/*", ".circleci/*", "azure-pipelines.yml",
         "Jenkinsfile", "bitbucket-pipelines.yml", ".buildkite/*", ".drone.yml", "buildspec.yml", "codemagic.yaml", "bitrise.yml"],
  "build_config": ["pyproject.toml", "setup.py", "setup.cfg", "requirements*.txt", "Pipfile", "tox.ini", "noxfile.py", "pytest.ini",
                   ".coveragerc", "package.json", "pnpm-workspace.yaml", "lerna.json", "nx.json", "turbo.json", "tsconfig*.json",
                   "jsconfig.json", "vite.config.*", "vitest.config.*", "vitest.workspace.*", "jest.config.*", "babel.config.*",
                   ".babelrc*", "playwright.config.*", "cypress.config.*", "webpack.config.*", "rollup.config.*", ".swcrc",
                   ".env", ".env.*", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", "gradle.properties",
                   "gradle/libs.versions.toml", "pom.xml", "go.mod", "Cargo.toml", "pubspec.yaml", "analysis_options.yaml",
                   "Package.swift", "Podfile", "*.xcodeproj/*", "*.csproj", "*.sln", "Directory.Build.props", "Makefile",
                   "Dockerfile", "docker-compose*.yml", ".tool-versions", ".nvmrc", ".node-version", ".python-version",
                   "BUILD", "BUILD.bazel", "WORKSPACE", "MODULE.bazel"],
  "fixture": ["conftest.py", "*/fixtures/*", "*/factories/*", "*/factory/*", "*/testutils/*", "*/test_utils/*", "*/test-utils/*",
              "*/helpers/*", "*/support/*", "*/__mocks__/*", "*/mocks/*", "*/seeds/*", "*/test/setup.*", "*/tests/setup.*",
              "setupTests.*", "jest.setup.*", "vitest.setup.*", "*/testing/*"],
  "snapshot": ["*/__snapshots__/*.snap", "*/__screenshots__/*", "*-snapshots/*"],
  "schema": ["*.graphql", "*.gql", "*.proto", "*openapi*.yaml", "*openapi*.yml", "*openapi*.json", "*swagger*.yaml",
             "*swagger*.json", "*.schema.json", "*.avsc", "*.prisma", "schema.sql", "*/schema/*"],
  "data_ext": [".json", ".yaml", ".yml", ".csv", ".tsv", ".xml", ".toml", ".ndjson", ".jsonl"],
  "non_code": ["*.css", "*.scss", "*.sass", "*.less", "*.styl", "*.html", "*.htm", "*.hbs", "*.handlebars", "*.njk", "*.jinja",
               "*.jinja2", "*.j2", "*.mustache", "*.ejs", "*.svg", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.avif",
               "*.ico", "*.woff", "*.woff2", "*.ttf", "*.otf", "*.po", "*.pot", "*.mo", "*.arb", "*.strings", "*.stringsdict",
               "*.xliff", "*.xlf", "*.resx", "*/locales/*", "*/locale/*", "*/i18n/*", "*/translations/*", "*/templates/*",
               "*/res/layout/*", "*/res/values/*", "*.storyboard", "*.xib"],
  "docs": ["*.md", "*.mdx", "*.rst", "*.adoc", "*.txt", "docs/*", "LICENSE*", "CHANGELOG*", "AUTHORS*", "CODEOWNERS", ".github/ISSUE_TEMPLATE/*",
           ".github/PULL_REQUEST_TEMPLATE*", ".editorconfig", ".gitignore", ".gitattributes"],
  "e2e_tests": ["*/e2e/*", "*/cypress/*", "*.e2e.*", "*.cy.*", "*/acceptance/*", "*/androidTest/*", "*UITests/*", "*/integration_test/*",
                "*/.maestro/*", "*/maestro/*", "*/playwright/*"],
  "visual_tests": ["*/visual/*", "*.visual.*", "*/screenshots/*", "*.screenshot.*", "*/percy/*", "*/chromatic/*", "*/backstop/*"],
  "contract_tests": ["*/contract/*", "*/contracts/*", "*.contract.*", "*_contract_test.*", "*/pact/*", "*.pact.*"]
}

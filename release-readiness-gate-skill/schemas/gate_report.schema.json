{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/release-readiness-gate/gate_report.schema.json",
  "title": "Release readiness gate report",
  "type": "object",
  "required": ["schema_version", "skill", "generated_at", "as_of", "candidate", "inputs", "policy", "waivers", "headline", "requirements", "conditions", "sources",
               "missing_evidence", "blockers", "warnings", "waived", "expired_or_invalid_waivers", "unused_waivers", "risks_accepted", "rules", "issues",
               "untested", "limitations", "open_questions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "release-readiness-gate"}}},
    "generated_at": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "candidate": {"type": "object", "required": ["commit", "release_type"],
      "properties": {"commit": {"type": "string"}, "build_id": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]},
                     "target_url": {"type": ["string", "null"]}, "release_type": {"type": "string"}, "previous_tag": {"type": ["string", "null"]}}},
    "inputs": {"type": "object", "required": ["reports", "reports_kind", "repo_used"],
      "properties": {"reports_kind": {"enum": ["directory", "manifest"]}, "repo_used": {"type": "boolean"}}},
    "policy": {"type": "object", "required": ["path", "sha256", "starter", "release_type", "waiver_approvers", "show_threshold"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "starter": {"type": "boolean"},
                     "waiver_approvers": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}}},
    "waivers": {"type": ["object", "null"], "required": ["path", "sha256"]},
    "headline": {"type": "object",
      "required": ["verdict", "statement", "blocker_count", "waived_count", "missing_evidence_count", "warning_count", "evidence_completeness", "overall_confidence"],
      "properties": {"verdict": {"enum": ["go", "no_go", "not_established"]}, "statement": {"type": "string"},
                     "evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1}, "overall_confidence": {"enum": ["high", "medium", "low"]}}},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["id", "skill", "status"],
      "properties": {"status": {"enum": ["met", "absent", "invalid", "validator_not_run", "stale", "unverified", "not_required"]}}}},
    "conditions": {"type": "object"},
    "sources": {"type": "array", "items": {"type": "object",
      "required": ["path", "sha256", "type", "skill", "required", "counted", "superseded", "validator", "freshness", "freshness_reasons"],
      "properties": {
        "validator": {"type": "object", "required": ["command", "exit_code", "status", "errors"], "properties": {"status": {"enum": ["valid", "invalid", "not_run"]}}},
        "freshness": {"enum": ["fresh", "stale", "unverified"]},
        "freshness_reasons": {"type": "array", "items": {"type": "string"}},
        "commits_behind": {"type": ["integer", "null"]}, "changed_since": {"type": ["array", "null"]}}}},
    "missing_evidence": {"type": "array", "items": {"type": "object", "required": ["requirement", "reason", "produced_by_skill", "how_to_produce"],
      "properties": {"reason": {"enum": ["absent", "invalid", "validator_not_run", "stale", "unverified"]}}}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "warnings": {"type": "array", "items": {"type": "object", "required": ["rule_id", "source", "measure", "threshold"]}},
    "waived": {"type": "array", "items": {"type": "object",
      "required": ["issue_id", "rule_ids", "waiver_id", "approver", "approver_category", "reason", "expires", "finding_ids"]}},
    "expired_or_invalid_waivers": {"type": "array", "items": {"type": "object", "required": ["waiver_id", "problems"]}},
    "unused_waivers": {"type": "array", "items": {"type": "string"}},
    "risks_accepted": {"type": "array", "items": {"type": "object", "required": ["skill", "issues"]}},
    "rules": {"type": "array", "items": {"type": "object", "required": ["rule_id", "effect", "status"],
      "properties": {"effect": {"enum": ["block", "warn"]}, "status": {"enum": ["fired", "not_fired", "not_evaluable"]}}}},
    "issues": {"type": "array", "items": {"type": "object", "required": ["issue_id", "title", "severity", "priority", "confidence", "sources", "merge_reason"]}},
    "untested": {"type": "array", "items": {"type": "object", "required": ["source", "skill", "category", "items"]}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array"}
  },
  "$defs": {
    "blocker": {"type": "object", "required": ["issue_id", "rule_ids", "title", "severity", "priority", "confidence", "sources", "location", "why_blocking"],
      "properties": {
        "rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "priority": {"enum": ["P0", "P1", "P2", "P3", null]},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["skill", "finding_id", "path"]}}}}
  }
}

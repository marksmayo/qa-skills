{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/release-readiness-gate/waivers.schema.json",
  "title": "Waivers for one release",
  "description": "Versioned with the release. A waiver someone mentions in conversation is an open question, not a waiver.",
  "type": "object",
  "required": ["schema_version", "waivers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release": {"type": "string"},
    "waivers": {"type": "array", "items": {"type": "object", "required": ["id", "finding_ids", "approver", "reason", "expires"],
      "properties": {
        "id": {"type": "string"},
        "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9:-]+:[^*]+$"},
                        "description": "skill:finding_id for each finding; never a whole skill or a wildcard"},
        "approver": {"type": "string", "description": "must be on the policy's waiver_approvers list for each finding's category"},
        "reason": {"type": "string", "minLength": 10},
        "expires": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "approved_on": {"type": "string"}}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/visual-regression-reviewer/visual_review.schema.json",
  "title": "Visual regression review",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "scope", "metadata", "headline", "groups", "unchanged", "added", "removed", "untested", "files_written",
               "limitations"],
  "properties": {
    "skill": {"type": "object", "additionalProperties": false, "required": ["name", "version"],
              "properties": {"name": {"enum": ["visual-regression-reviewer"]}, "version": {"type": "string"}}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "sets", "browsers", "viewports", "pages", "ignore_regions", "threshold", "min_region_pixels", "change_context",
                   "authorised_by"],
      "properties": {
        "mode": {"enum": ["compare", "capture_and_compare", "capture_both", "playwright"]},
        "sets": {"type": "object"},
        "browsers": {"type": "array", "items": {"type": "string"}},
        "viewports": {"type": "array", "items": {"type": "string"}},
        "pages": {"type": "array", "items": {"type": "string"}},
        "ignore_regions": {"type": "object"},
        "threshold": {"type": "number"},
        "min_region_pixels": {"type": "integer"},
        "change_context": {"oneOf": [{"type": "null"},
                                     {"type": "object", "additionalProperties": false, "required": ["source", "summary"],
                                      "properties": {"source": {"type": "string"}, "summary": {"type": "string"}}}]},
        "authorised_by": {"type": ["string", "null"]}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["generated_at", "browser_versions", "tools", "pairs", "groups_file"],
      "properties": {
        "generated_at": {"type": "string"},
        "browser_versions": {"type": "object"},
        "tools": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "status", "note"],
          "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]},
                         "status": {"enum": ["ran", "not_run", "errored"]}, "note": {"type": ["string", "null"]}}}},
        "pairs": {"type": "object", "additionalProperties": false, "required": ["matched", "added", "removed", "size_mismatch"],
                  "properties": {"matched": {"type": "integer"}, "added": {"type": "integer"}, "removed": {"type": "integer"},
                                 "size_mismatch": {"type": "integer"}}},
        "groups_file": {"type": "string"}
      }
    },
    "headline": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "groups_by_impact", "groups_by_cause", "pairs_compared", "pages_compared", "pages_untested",
                   "flaky_pixels_excluded", "evidence_completeness", "overall_confidence", "approval"],
      "properties": {
        "summary": {"type": "string", "minLength": 20},
        "groups_by_impact": {"type": "object"},
        "groups_by_cause": {"type": "object"},
        "pairs_compared": {"type": "integer"},
        "pages_compared": {"type": "array", "items": {"type": "string"}},
        "pages_untested": {"type": "array", "items": {"type": "string"}},
        "flaky_pixels_excluded": {"type": "integer"},
        "evidence_completeness": {"enum": ["complete", "partial"]},
        "overall_confidence": {"enum": ["high", "medium", "low"]},
        "approval": {"enum": ["none"]}
      }
    },
    "groups": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "cause", "impact", "confidence", "reach", "review_score", "review_order", "noise", "intent", "intent_basis",
                   "intent_confidence", "element_sigs", "pages", "viewports", "browsers", "measure", "pixels", "aa_pixels",
                   "flaky_pixels", "crops", "explanation"],
      "properties": {
        "id": {"type": "string", "pattern": "^G[0-9]+$"},
        "cause": {"enum": ["layout_shift", "missing_element", "new_element", "text_change", "colour_change", "image_change",
                           "font_rendering", "dynamic_content", "unexplained"]},
        "impact": {"enum": ["high", "medium", "low"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "reach": {"enum": [1, 2, 3]},
        "review_score": {"type": "integer"},
        "review_order": {"type": "integer", "minimum": 1},
        "noise": {"type": "boolean"},
        "intent": {"enum": ["likely_intended", "likely_unintended", "unknown"]},
        "intent_basis": {"enum": ["agent_judgment", "none"]},
        "intent_confidence": {"enum": ["low", "medium", null]},
        "element_sigs": {"type": "array", "items": {"type": "string"}},
        "pages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "viewports": {"type": "array", "items": {"type": "string"}},
        "browsers": {"type": "array", "items": {"type": "string"}},
        "measure": {"type": "object"},
        "pixels": {"type": "integer"}, "aa_pixels": {"type": "integer"}, "flaky_pixels": {"type": "integer"},
        "crops": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["pair", "box", "baseline", "current", "diff"],
          "properties": {"pair": {"type": "string"}, "box": {"type": "array"}, "baseline": {"type": "string"}, "current": {"type": "string"},
                         "diff": {"type": "string"}}}},
        "explanation": {"type": "string", "minLength": 10}
      }
    }},
    "unchanged": {"type": "array", "items": {"type": "object", "required": ["pair", "flaky_pixels"]}},
    "added": {"type": "array", "items": {"type": "string"}},
    "removed": {"type": "array", "items": {"type": "string"}},
    "untested": {"type": "array", "items": {"type": "object", "required": ["pair", "reason"]}},
    "files_written": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

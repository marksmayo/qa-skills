{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Suite Evaluation",
  "type": "object",
  "required": [
    "metadata",
    "headline",
    "dimensions",
    "critical_findings",
    "recommendations",
    "evidence_inventory"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "repository",
        "assessment_mode",
        "execution",
        "generated_at",
        "skill_version"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "assessment_mode": {
          "enum": [
            "black_box",
            "grey_box",
            "white_box"
          ]
        },
        "execution": {
          "enum": [
            "full_run",
            "partial_run",
            "reports_only",
            "static_only",
            "not_executable"
          ],
          "description": "Strongest execution evidence: every test layer was run during the assessment (full_run); some layers or tests were run and at least one layer was not (partial_run); credible existing reports were read instead (reports_only); nothing was run and no reports exist (static_only); or discovery or execution was attempted and failed with no credible reports (not_executable)."
        },
        "generated_at": {
          "type": "string"
        },
        "provisional": {
          "type": "boolean",
          "description": "true exactly when no execution evidence supports the scores (execution static_only or not_executable)."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "The SKILL.md version this evaluation was written for; it names the contract."
        },
        "execution_result": {
          "type": "object",
          "description": "What the runs showed. Required for full_run and partial_run.",
          "required": [
            "layers",
            "runs"
          ],
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "array",
              "minItems": 1,
              "description": "Every test layer the repository has (unit, component, integration, e2e...), run or not.",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "framework": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "run",
                      "partial",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why the layer was not run or only partly run."
                  }
                }
              }
            },
            "runs": {
              "type": "array",
              "description": "Each execution the counts come from, in order.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "origin",
                  "layers",
                  "passed",
                  "failed",
                  "skipped",
                  "errored"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "origin": {
                    "enum": [
                      "assessor",
                      "ci_report",
                      "local_report"
                    ],
                    "description": "assessor: run during this assessment. Assessor runs never count as historical CI."
                  },
                  "command": {
                    "type": "string"
                  },
                  "layers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "passed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "skipped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "errored": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "duration_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "coverage": {
                    "type": "boolean",
                    "description": "true when the run was instrumented for coverage."
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "failures": {
              "type": "array",
              "description": "Failing or erroring tests (or groups of them), each classified.",
              "items": {
                "type": "object",
                "required": [
                  "test",
                  "class",
                  "evidence"
                ],
                "additionalProperties": false,
                "properties": {
                  "test": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Tests in this group (default 1)."
                  },
                  "class": {
                    "enum": [
                      "product",
                      "test",
                      "environment",
                      "unknown"
                    ]
                  },
                  "runs_failed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Ids of the runs it failed in; fewer than all runs is a flakiness observation."
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "headline": {
      "type": "object",
      "required": [
        "raw_weighted_score",
        "overall_score",
        "rating_band",
        "testing_effectiveness",
        "suite_trustworthiness",
        "engineering_quality",
        "operational_health",
        "evidence_completeness",
        "overall_confidence",
        "applied_caps"
      ],
      "properties": {
        "raw_weighted_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "overall_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "rating_band": {
          "enum": [
            "Dysfunctional",
            "Weak",
            "Serviceable",
            "Strong",
            "Excellent",
            "Exceptional"
          ]
        },
        "testing_effectiveness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "suite_trustworthiness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "engineering_quality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "operational_health": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "evidence_completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "overall_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "applied_caps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "limit",
              "explanation"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "effectiveness_below_4",
                  "trust_below_4",
                  "reliability_below_4",
                  "assertions_below_3",
                  "coverage_below_4",
                  "not_executable",
                  "secret_or_production_data",
                  "systematic_false_pass",
                  "static_only"
                ]
              },
              "limit": {
                "type": "number",
                "minimum": 1,
                "maximum": 10
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "weight",
          "score",
          "confidence",
          "evidence_level",
          "finding"
        ],
        "properties": {
          "id": {
            "enum": [
              "effectiveness",
              "trust",
              "reliability",
              "design",
              "assertions",
              "coverage",
              "isolation",
              "maintainability",
              "ci",
              "debuggability",
              "performance",
              "test_data",
              "portability",
              "security_a11y",
              "ownership"
            ]
          },
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "applicable": {
            "type": "boolean",
            "description": "false only when the dimension genuinely does not apply; its weight is then 0 and its score null. Missing evidence is not a reason."
          },
          "not_applicable_reason": {
            "type": "string"
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_level": {
            "enum": [
              "verified",
              "specification_derived",
              "test_derived",
              "mixed",
              "unknown"
            ],
            "description": "The level of all the dimension's evidence. When its evidence items have different levels, use mixed and give every item its own level."
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ],
              "description": "A string inherits the dimension's evidence level; an object states its own. In a mixed dimension every item is an object.",
              "required": [
                "text",
                "level"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][\\w-]*$",
                  "description": "Lets a sentence of the finding, risks or recommendations cite this item as [id]."
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "enum": [
                    "verified",
                    "specification_derived",
                    "test_derived"
                  ]
                }
              }
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "critical_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "impact": {
            "type": "string"
          },
          "category": {
            "enum": [
              "secret_exposure",
              "production_data_exposure",
              "systematic_false_pass",
              "other"
            ],
            "description": "secret_exposure and production_data_exposure must be severity critical and cap the overall at 4 until remediated; systematic_false_pass (broad error swallowing, globally excessive retries, systematic false passes) caps it at 4."
          },
          "remediated": {
            "type": "boolean"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "effectiveness",
                "trust",
                "reliability",
                "design",
                "assertions",
                "coverage",
                "isolation",
                "maintainability",
                "ci",
                "debuggability",
                "performance",
                "test_data",
                "portability",
                "security_a11y",
                "ownership"
              ]
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "priority",
          "category",
          "impact",
          "effort",
          "action",
          "acceptance_criteria"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "enum": [
              "critical_risk",
              "top_improvement",
              "quick_win",
              "structural",
              "evidence_needed"
            ],
            "description": "Step 9 group: critical confidence risks, the three highest-leverage improvements, quick wins, structural improvements, evidence needed for a stronger reassessment. Priorities rank the groups in this order."
          },
          "impact": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "effort": {
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "action": {
            "type": "string"
          },
          "dimensions_affected": {
            "type": "array",
            "items": {
              "enum": [
                "effectiveness",
                "trust",
                "reliability",
                "design",
                "assertions",
                "coverage",
                "isolation",
                "maintainability",
                "ci",
                "debuggability",
                "performance",
                "test_data",
                "portability",
                "security_a11y",
                "ownership"
              ]
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "application_source",
                "test_source",
                "ci_configuration",
                "recent_execution",
                "historical_ci",
                "runtime_coverage",
                "mutation_report",
                "requirements",
                "defect_history"
              ]
            },
            "description": "For evidence_needed: the inventory kinds (missing or partial) the evidence would supply."
          }
        }
      }
    },
    "evidence_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "application_source",
              "test_source",
              "ci_configuration",
              "recent_execution",
              "historical_ci",
              "runtime_coverage",
              "mutation_report",
              "requirements",
              "defect_history",
              "other"
            ],
            "description": "The RUBRIC evidence-completeness item this entry counts as; 'other' entries score no points."
          },
          "status": {
            "enum": [
              "available",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "details": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "repository",
              "ci",
              "supplied",
              "assessor"
            ],
            "description": "Where the evidence came from. assessor: produced during this assessment (never historical_ci)."
          },
          "as_of": {
            "type": "string",
            "description": "Date the evidence describes, for reports and logs."
          }
        }
      }
    },
    "behavioural_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string"
          },
          "happy_path": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "negative": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "boundary": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "permissions": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "dependency_failure": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "concurrency": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "recovery": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "feature"
        ]
      }
    },
    "interface_coverage": {
      "type": "array",
      "description": "Interfaces (routes, endpoints, server actions, pages, operations, CLI commands) mapped to the tests that reach them. Not code coverage.",
      "items": {
        "type": "object",
        "required": [
          "interface",
          "kind",
          "total",
          "tested",
          "method",
          "evidence_level"
        ],
        "additionalProperties": false,
        "properties": {
          "interface": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "routes",
              "endpoints",
              "server_actions",
              "pages",
              "operations",
              "commands",
              "cli",
              "other"
            ]
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "tested": {
            "type": "integer",
            "minimum": 0
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "description": "How interfaces were matched to tests."
          },
          "evidence_level": {
            "enum": [
              "verified",
              "specification_derived",
              "test_derived"
            ]
          },
          "untested": {
            "type": "array",
            "description": "Every untested interface: a name, or a group {group, count} standing for count interfaces. The entries account for exactly total - tested.",
            "items": {
              "type": [
                "string",
                "object"
              ],
              "minLength": 1,
              "required": [
                "group",
                "count"
              ],
              "additionalProperties": false,
              "properties": {
                "group": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "environment": {
            "type": "string",
            "description": "Relevant environment: OS, runtime version, workers, fake env vars set, network guard."
          },
          "run": {
            "type": "string",
            "description": "The execution_result run id this command produced."
          }
        }
      }
    }
  },
  "description": "Output contract of the test-suite-evaluator skill, 1.2. Dimension ids renamed in 1.1: trustworthiness->trust, oracles->assertions, scope->coverage, data->test_data, environment->portability, crosscutting->security_a11y."
}

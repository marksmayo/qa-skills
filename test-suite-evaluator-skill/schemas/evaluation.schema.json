{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Suite Evaluation",
  "type": "object",
  "required": [
    "metadata",
    "headline",
    "dimensions",
    "critical_findings",
    "recommendations",
    "evidence_inventory"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "repository",
        "assessment_mode",
        "execution",
        "generated_at"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "assessment_mode": {
          "enum": [
            "black_box",
            "grey_box",
            "white_box"
          ]
        },
        "execution": {
          "enum": [
            "full_run",
            "partial_run",
            "reports_only",
            "static_only",
            "not_executable"
          ],
          "description": "Strongest execution evidence: the suite was run in full or in part during the assessment (full_run, partial_run), credible existing reports were read instead (reports_only), nothing was run and no reports exist (static_only), or discovery or execution was attempted and failed with no credible reports (not_executable)."
        },
        "generated_at": {
          "type": "string"
        },
        "provisional": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skill_version": {
          "type": "string"
        }
      }
    },
    "headline": {
      "type": "object",
      "required": [
        "raw_weighted_score",
        "overall_score",
        "rating_band",
        "testing_effectiveness",
        "suite_trustworthiness",
        "engineering_quality",
        "operational_health",
        "evidence_completeness",
        "overall_confidence",
        "applied_caps"
      ],
      "properties": {
        "raw_weighted_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "overall_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "rating_band": {
          "enum": [
            "Dysfunctional",
            "Weak",
            "Serviceable",
            "Strong",
            "Excellent",
            "Exceptional"
          ]
        },
        "testing_effectiveness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "suite_trustworthiness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "engineering_quality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "operational_health": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "evidence_completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "overall_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "applied_caps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "limit",
              "explanation"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "effectiveness_below_4",
                  "trust_below_4",
                  "reliability_below_4",
                  "assertions_below_3",
                  "not_executable",
                  "secret_or_production_data",
                  "systematic_false_pass",
                  "static_only"
                ]
              },
              "limit": {
                "type": "number",
                "minimum": 1,
                "maximum": 10
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "weight",
          "score",
          "confidence",
          "evidence_level",
          "finding"
        ],
        "properties": {
          "id": {
            "enum": [
              "effectiveness",
              "trust",
              "reliability",
              "design",
              "assertions",
              "coverage",
              "isolation",
              "maintainability",
              "ci",
              "debuggability",
              "performance",
              "test_data",
              "portability",
              "security_a11y",
              "ownership"
            ]
          },
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "applicable": {
            "type": "boolean",
            "description": "false only when the dimension genuinely does not apply; its weight is then 0 and its score null. Missing evidence is not a reason."
          },
          "not_applicable_reason": {
            "type": "string"
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_level": {
            "enum": [
              "verified",
              "specification_derived",
              "test_derived",
              "unknown"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "critical_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "impact": {
            "type": "string"
          },
          "category": {
            "enum": [
              "secret_exposure",
              "production_data_exposure",
              "systematic_false_pass",
              "other"
            ],
            "description": "secret_exposure and production_data_exposure must be severity critical and cap the overall at 4 until remediated; systematic_false_pass (broad error swallowing, globally excessive retries, systematic false passes) caps it at 4."
          },
          "remediated": {
            "type": "boolean"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "priority",
          "impact",
          "effort",
          "action",
          "acceptance_criteria"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "impact": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "effort": {
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "action": {
            "type": "string"
          },
          "dimensions_affected": {
            "type": "array",
            "items": {
              "enum": [
                "effectiveness",
                "trust",
                "reliability",
                "design",
                "assertions",
                "coverage",
                "isolation",
                "maintainability",
                "ci",
                "debuggability",
                "performance",
                "test_data",
                "portability",
                "security_a11y",
                "ownership"
              ]
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "application_source",
              "test_source",
              "ci_configuration",
              "recent_execution",
              "historical_ci",
              "runtime_coverage",
              "mutation_report",
              "requirements",
              "defect_history",
              "other"
            ],
            "description": "The RUBRIC evidence-completeness item this entry counts as; 'other' entries score no points."
          },
          "status": {
            "enum": [
              "available",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "behavioural_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string"
          },
          "happy_path": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "negative": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "boundary": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "permissions": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "dependency_failure": {
            "enum": [
              "covered",
              "partial",
              "not_covered",
              "not_applicable",
              "unknown"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "feature"
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}

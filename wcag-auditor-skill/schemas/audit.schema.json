{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/wcag-auditor/audit.schema.json",
  "title": "WCAG audit",
  "description": "Output of the wcag-auditor skill. The verdict is never 'conforms'; tool passes never establish an SC pass; untested SCs become a manual test plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "generated_at", "scope", "metadata", "headline", "sc_results", "findings",
               "advisories", "needs_review", "triage", "manual_test_plan", "assisted_review", "limitations", "files_written"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {"type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"const": "wcag-auditor"}, "version": {"type": "string"}}},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "scope": {"type": "object", "additionalProperties": false,
      "required": ["targets", "wcag_version", "level", "exclusions", "authorised_by", "allow_form_submission", "standards_map", "critical_paths"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https?://"}},
        "wcag_version": {"enum": ["2.0", "2.1", "2.2"]},
        "level": {"enum": ["A", "AA", "AAA"]},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "authorised_by": {"type": "string", "minLength": 3},
        "allow_form_submission": {"type": "boolean"},
        "standards_map": {"enum": [null, "en301549"]},
        "critical_paths": {"type": "array", "items": {"$ref": "#/$defs/critical_path"}}
      }},
    "metadata": {"type": "object", "additionalProperties": false,
      "required": ["browser", "playwright", "tools", "viewports", "auth_used", "sample", "unsampled_count", "checks", "blocked_requests", "events", "run_dir"],
      "properties": {
        "browser": {"type": "object", "additionalProperties": false, "required": ["name", "version"],
          "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
        "playwright": {"type": "string"},
        "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}},
        "viewports": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\d+x\\d+$"}},
        "auth_used": {"type": "boolean"},
        "sample": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample_page"}},
        "unsampled_count": {"type": "integer", "minimum": 0},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "blocked_requests": {"type": "integer", "minimum": 0},
        "events": {"type": "array", "items": {"type": "string"}},
        "run_dir": {"type": "string"}
      }},
    "headline": {"type": "object", "additionalProperties": false,
      "required": ["conformance_verdict", "verdict_text", "severity_counts", "sc_coverage", "evidence_completeness", "overall_confidence", "blocked_critical_paths"],
      "properties": {
        "conformance_verdict": {"enum": ["does_not_conform", "not_established"]},
        "verdict_text": {"type": "string", "minLength": 20},
        "severity_counts": {"type": "object", "additionalProperties": false, "required": ["critical", "serious", "moderate", "minor"],
          "properties": {"critical": {"type": "integer", "minimum": 0}, "serious": {"type": "integer", "minimum": 0},
                         "moderate": {"type": "integer", "minimum": 0}, "minor": {"type": "integer", "minimum": 0}}},
        "sc_coverage": {"type": "object", "additionalProperties": false, "required": ["total", "failed", "passed", "cantTell", "inapplicable", "untested"],
          "properties": {"total": {"type": "integer"}, "failed": {"type": "integer"}, "passed": {"type": "integer"},
                         "cantTell": {"type": "integer"}, "inapplicable": {"type": "integer"}, "untested": {"type": "integer"}}},
        "evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "overall_confidence": {"enum": ["high", "medium", "low"]},
        "blocked_critical_paths": {"type": "array", "items": {"type": "string"}}
      }},
    "sc_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sc_result"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "advisories": {"type": "array", "items": {"$ref": "#/$defs/advisory"}},
    "needs_review": {"type": "array", "items": {"$ref": "#/$defs/needs_review"}},
    "triage": {"type": "array", "items": {"$ref": "#/$defs/triage"}},
    "manual_test_plan": {"type": "array", "items": {"$ref": "#/$defs/manual_test"}},
    "assisted_review": {"type": "object", "additionalProperties": false, "required": ["scs_reviewed", "method", "notes"],
      "properties": {"scs_reviewed": {"type": "array", "items": {"$ref": "#/$defs/sc_id"}},
                     "method": {"type": "string", "minLength": 10}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "files_written": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sc_id": {"type": "string", "pattern": "^[1-4]\\.\\d{1,2}\\.\\d{1,2}$"},
    "severity": {"enum": ["critical", "serious", "moderate", "minor"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "critical_path": {"type": "object", "additionalProperties": false, "required": ["name", "steps"],
      "properties": {"name": {"type": "string", "minLength": 3},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["url", "label"],
          "properties": {"url": {"type": "string"}, "state": {"type": ["string", "null"]}, "label": {"type": "string"}}}}}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["name", "version", "license", "status", "reason"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "license": {"type": "string"},
                     "status": {"enum": ["ran", "not_run", "errored"]}, "reason": {"type": "string"},
                     "sha256": {"type": ["string", "null"]}}},
    "sample_page": {"type": "object", "additionalProperties": false, "required": ["id", "url", "template", "reason", "title"],
      "properties": {"id": {"type": "string", "pattern": "^p\\d{2,}$"}, "url": {"type": "string"}, "template": {"type": ["string", "null"]},
                     "reason": {"enum": ["listed", "structured", "random", "critical_path", "unreachable", "blocked"]},
                     "title": {"type": ["string", "null"]}, "note": {"type": "string"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["page", "viewport", "kind", "name", "status"],
      "properties": {"page": {"type": "string"}, "viewport": {"type": "string"}, "kind": {"enum": ["engine", "probe"]},
                     "name": {"type": "string"}, "status": {"enum": ["ran", "not_run", "errored", "blocked"]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["tool", "version", "rule_id", "act_rules"],
      "properties": {"tool": {"type": "string"}, "version": {"type": ["string", "null"]}, "rule_id": {"type": "string"},
                     "act_rules": {"type": "array", "items": {"type": "string"}}, "outcome": {"enum": ["failed", "cantTell"]}}},
    "instance": {"type": "object", "additionalProperties": false, "required": ["page", "url", "viewport", "state", "selector", "html_snippet", "screenshot"],
      "properties": {"page": {"type": "string"}, "url": {"type": "string"}, "viewport": {"type": "string"}, "state": {"type": "string"},
                     "selector": {"type": ["string", "null"]}, "xpath": {"type": ["string", "null"]},
                     "html_snippet": {"type": ["string", "null"]}, "screenshot": {"type": ["string", "null"]}}},
    "sc_result": {"type": "object", "additionalProperties": false,
      "required": ["sc", "title", "level", "principle", "outcome", "confidence", "automatable", "finding_ids", "basis", "evidence_note"],
      "properties": {"sc": {"$ref": "#/$defs/sc_id"}, "title": {"type": "string"}, "level": {"enum": ["A", "AA", "AAA"]},
                     "principle": {"enum": ["Perceivable", "Operable", "Understandable", "Robust"]},
                     "outcome": {"enum": ["passed", "failed", "cantTell", "inapplicable", "untested"]},
                     "confidence": {"$ref": "#/$defs/confidence"}, "automatable": {"enum": ["full", "partial", "none"]},
                     "finding_ids": {"type": "array", "items": {"type": "string"}},
                     "needs_review_ids": {"type": "array", "items": {"type": "string"}},
                     "basis": {"type": "array", "items": {"enum": ["tool", "probe", "agent_review", "manual"]}},
                     "evidence_note": {"type": "string", "minLength": 5}, "en301549_clause": {"type": ["string", "null"]}}},
    "finding": {"type": "object", "additionalProperties": false,
      "required": ["id", "title", "sc", "level", "pattern", "base_severity", "severity", "severity_rationale", "confidence", "priority",
                   "evidence_type", "sources", "candidate_ids", "component", "pages", "instances", "user_impact", "affected_users",
                   "remediation", "verification_step", "non_interference", "critical_path", "blocks_critical_path"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-\\d+$"}, "title": {"type": "string", "minLength": 10},
        "sc": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sc_id"}}, "level": {"enum": ["A", "AA"]},
        "pattern": {"type": "string"}, "base_severity": {"$ref": "#/$defs/severity"}, "severity": {"$ref": "#/$defs/severity"},
        "severity_rationale": {"type": "string", "minLength": 15}, "severity_override_reason": {"type": "string", "minLength": 15},
        "confidence": {"$ref": "#/$defs/confidence"},
        "priority": {"type": "object", "additionalProperties": false, "required": ["band", "score", "reach", "leverage"],
          "properties": {"band": {"enum": ["P0", "P1", "P2", "P3"]}, "score": {"type": "integer", "minimum": 1},
                         "reach": {"type": "integer", "minimum": 1, "maximum": 3}, "leverage": {"type": "integer", "minimum": 1, "maximum": 2}}},
        "evidence_type": {"enum": ["tool", "probe", "agent_judgment"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "candidate_ids": {"type": "array", "items": {"type": "string", "pattern": "^C-\\d+$"}},
        "component": {"type": "string"}, "pages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "instances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instance"}},
        "user_impact": {"type": "string", "minLength": 20}, "affected_users": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "remediation": {"type": "string", "minLength": 20}, "verification_step": {"type": "string", "minLength": 15},
        "non_interference": {"type": "boolean"},
        "critical_path": {"type": ["object", "null"], "additionalProperties": false, "required": ["name", "step"],
          "properties": {"name": {"type": "string"}, "step": {"type": "string"}}},
        "blocks_critical_path": {"type": "boolean"},
        "resolution": {"type": "string", "minLength": 20},
        "en301549": {"type": "array", "items": {"type": "string"}}
      }},
    "advisory": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "title", "sc", "candidate_ids", "sources", "pages", "note", "remediation"],
      "properties": {"id": {"type": "string", "pattern": "^A-\\d+$"}, "kind": {"enum": ["best_practice", "above_target_level", "outside_version"]},
                     "title": {"type": "string", "minLength": 10}, "sc": {"type": "array", "items": {"$ref": "#/$defs/sc_id"}},
                     "candidate_ids": {"type": "array", "items": {"type": "string"}}, "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
                     "pages": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string", "minLength": 10},
                     "remediation": {"type": "string", "minLength": 10}}},
    "needs_review": {"type": "object", "additionalProperties": false, "required": ["id", "sc", "candidate_ids", "what_to_check", "pages", "sources"],
      "properties": {"id": {"type": "string", "pattern": "^NR-\\d+$"}, "sc": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sc_id"}},
                     "candidate_ids": {"type": "array", "items": {"type": "string"}}, "what_to_check": {"type": "string", "minLength": 20},
                     "pages": {"type": "array", "items": {"type": "string"}}, "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}}},
    "triage": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "decision", "ref", "reason"],
      "properties": {"candidate_id": {"type": "string", "pattern": "^C-\\d+$"},
                     "decision": {"enum": ["finding", "needs_review", "advisory", "dismissed"]},
                     "ref": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 10}}},
    "manual_test": {"type": "object", "additionalProperties": false, "required": ["sc", "title", "why_untested", "steps", "pages"],
      "properties": {"sc": {"$ref": "#/$defs/sc_id"}, "title": {"type": "string"}, "why_untested": {"type": "string", "minLength": 10},
                     "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
                     "pages": {"type": "array", "items": {"type": "string"}}}}
  }
}

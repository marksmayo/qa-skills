{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/ci-suite-runner/preauth.schema.json",
  "title": "Pre-authorisation to start CI suites",
  "type": "object",
  "required": ["schema_version", "grants"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "grants": {"type": "array", "items": {"type": "object", "required": ["id", "granted_by", "granted_at", "expires", "suites", "environments"],
      "properties": {"expires": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                     "suites": {"type": "array", "minItems": 1, "items": {"type": "string", "not": {"const": "*"}}},
                     "environments": {"type": "array", "minItems": 1, "items": {"type": "string", "not": {"const": "*"}}}}}}
  }
}

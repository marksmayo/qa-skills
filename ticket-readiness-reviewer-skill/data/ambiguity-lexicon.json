{
 "version": "1.0.0",
 "notes": "Mechanical lint for acceptance criteria. Each hit is tool evidence that a term is present, not proof of a defect: the agent keeps it as a flag or dismisses it with a reason (a glossary entry, a number elsewhere in the same criterion, a definition in the ticket). Terms match as whole words, case-insensitively. 'dimension' is the rubric dimension a kept flag counts against; 'confidence' is the flag's default confidence.",
 "kinds": {
  "vague_term": {
   "dimension": "clarity",
   "confidence": "medium",
   "question": "What exactly does \"{term}\" mean here? Say what a test would observe."
  },
  "unquantified_nfr": {
   "dimension": "nfr",
   "confidence": "medium",
   "question": "\"{term}\" needs a number and a unit (for example a p95 time, a rate or a limit)."
  },
  "open_ended": {
   "dimension": "completeness",
   "confidence": "high",
   "question": "\"{term}\" leaves the list open. Which cases are included?"
  },
  "undefined_reference": {
   "dimension": "clarity",
   "confidence": "high",
   "question": "\"{term}\" refers to something the ticket doesn't define. Where is it specified?"
  },
  "weak_modal": {
   "dimension": "clarity",
   "confidence": "medium",
   "question": "Is \"{term}\" a requirement or a nice-to-have?"
  },
  "compound": {
   "dimension": "testability",
   "confidence": "medium",
   "question": "This criterion covers more than one behaviour. Split it so each can pass or fail on its own."
  },
  "subjective_outcome": {
   "dimension": "testability",
   "confidence": "medium",
   "question": "\"{term}\" depends on opinion. What observable result shows it is met?"
  }
 },
 "terms": {
  "vague_term": [
   "appropriate",
   "appropriately",
   "properly",
   "correctly",
   "reasonable",
   "reasonably",
   "adequate",
   "sufficient",
   "relevant",
   "normal",
   "usual",
   "various",
   "several",
   "many",
   "few",
   "flexible",
   "robust",
   "seamless",
   "seamlessly",
   "smooth",
   "smoothly",
   "graceful",
   "gracefully",
   "handle",
   "handles",
   "handled",
   "support",
   "supports",
   "supported",
   "as needed",
   "as required",
   "where applicable",
   "if necessary",
   "and/or",
   "optimal",
   "optimised",
   "optimized",
   "minimal",
   "maximum possible",
   "recent",
   "soon"
  ],
  "unquantified_nfr": [
   "fast",
   "faster",
   "quick",
   "quickly",
   "slow",
   "responsive",
   "performant",
   "efficient",
   "efficiently",
   "scalable",
   "scale",
   "secure",
   "securely",
   "reliable",
   "reliably",
   "available",
   "high availability",
   "instant",
   "instantly",
   "real-time",
   "real time",
   "lightweight",
   "low latency"
  ],
  "open_ended": [
   "etc",
   "etc.",
   "and so on",
   "and more",
   "such as",
   "including but not limited to",
   "among others",
   "or similar",
   "e.g.",
   "for example"
  ],
  "undefined_reference": [
   "TBD",
   "TBC",
   "TODO",
   "to be decided",
   "to be confirmed",
   "the usual validation",
   "same as before",
   "as discussed",
   "as agreed",
   "see design",
   "per the design",
   "existing behaviour",
   "existing behavior",
   "like the old one",
   "the normal way"
  ],
  "weak_modal": [
   "should",
   "could",
   "might",
   "may",
   "ideally",
   "preferably",
   "if possible",
   "where possible",
   "try to",
   "aim to"
  ],
  "subjective_outcome": [
   "user-friendly",
   "user friendly",
   "intuitive",
   "intuitively",
   "easy",
   "easily",
   "simple",
   "simply",
   "clean",
   "nice",
   "pleasant",
   "modern",
   "clear",
   "clearly",
   "obvious",
   "better",
   "best"
  ]
 },
 "quantity_pattern": "\\b\\d+(?:[.,]\\d+)?\\s*(?:%|ms|milliseconds?|s|secs?|seconds?|minutes?|mins?|hours?|hrs?|days?|kb|mb|gb|rps|requests?|users?|items?|per\\s+\\w+|p\\d{2}|x)\\b|\\bp(?:50|75|90|95|99)\\b",
 "compound_pattern": "\\b(?:can|should|must|will|shall|is able to|are able to)\\s+(?:[\\w-]+\\s+){0,2}?[\\w-]+\\s+(?:and|or)\\s+(?:also\\s+)?(?!then\\b)[\\w-]+(?:\\s+[\\w-]+)?",
 "compound_exclude": [
  "terms and conditions",
  "black and white",
  "drag and drop",
  "copy and paste",
  "sign in or sign up",
  "up and running",
  "first and last name",
  "now and then"
 ],
 "nfr_hint_words": [
  "performance",
  "load",
  "latency",
  "throughput",
  "uptime",
  "availability",
  "security",
  "accessibility",
  "wcag",
  "response time",
  "concurrent"
 ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marksmayo/qa-skills/ticket-readiness-reviewer/readiness.schema.json",
  "title": "Ticket readiness review",
  "description": "Output of the ticket-readiness-reviewer skill. One review per ticket; a batch adds a worst-first ranking. A ready verdict claims only that the criteria are testable.",
  "type": "object",
  "required": ["schema_version", "skill", "generated_at", "rubric_version", "reviews"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill": {
      "type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": {"name": {"const": "ticket-readiness-reviewer"}, "version": {"type": "string"}}
    },
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "rubric_version": {"type": "string"},
    "lexicon_version": {"type": "string"},
    "batch": {
      "type": "object", "required": ["query", "source", "ranking", "counts"], "additionalProperties": false,
      "properties": {
        "query": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "ranking": {"type": "array", "items": {
          "type": "object", "required": ["rank", "key", "verdict", "readiness_score", "blocking_questions"],
          "additionalProperties": false,
          "properties": {
            "rank": {"type": "integer", "minimum": 1},
            "key": {"type": "string"},
            "verdict": {"$ref": "#/$defs/verdict_value"},
            "readiness_score": {"type": ["number", "null"]},
            "blocking_questions": {"type": "integer", "minimum": 0}
          }}},
        "counts": {
          "type": "object", "required": ["ready", "ready_with_questions", "not_ready", "not_assessed"],
          "additionalProperties": false,
          "properties": {
            "ready": {"type": "integer"}, "ready_with_questions": {"type": "integer"},
            "not_ready": {"type": "integer"}, "not_assessed": {"type": "integer"}
          }
        }
      }
    },
    "reviews": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review"}}
  },
  "$defs": {
    "verdict_value": {"enum": ["ready", "ready_with_questions", "not_ready", "not_assessed"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "review": {
      "type": "object",
      "required": ["ticket", "definition_of_ready", "criteria", "dismissed_flags", "dimensions", "questions",
                   "suggestions", "dependencies", "split_proposal", "code_checks", "suspicious_instructions_ignored",
                   "verdict", "comment_text", "limitations"],
      "additionalProperties": false,
      "properties": {
        "ticket": {
          "type": "object", "required": ["key", "type", "kind", "summary", "source", "content_sha256"],
          "additionalProperties": false,
          "properties": {
            "key": {"type": ["string", "null"]},
            "type": {"type": "string"},
            "kind": {"enum": ["story", "bug", "epic"]},
            "summary": {"type": "string"},
            "url": {"type": ["string", "null"]},
            "source": {"enum": ["connector", "rest", "pasted"]},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "definition_of_ready": {
          "type": "object", "required": ["source", "extra_items"], "additionalProperties": false,
          "properties": {
            "source": {"type": "string", "description": "built_in, or the path of the team's checklist"},
            "extra_items": {"type": "array", "items": {
              "type": "object", "required": ["id", "text", "status", "evidence"], "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^DOR-\\d+$"},
                "text": {"type": "string", "minLength": 1},
                "status": {"enum": ["met", "not_met", "not_assessed"]},
                "evidence": {"type": "string", "minLength": 1}
              }}}
          }
        },
        "criteria": {"type": "array", "items": {
          "type": "object", "required": ["id", "text", "source_field", "oracle", "flags"], "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^AC-\\d+[a-z]?$"},
            "text": {"type": "string", "minLength": 1},
            "source_field": {"type": "string"},
            "split_from": {"type": "string"},
            "oracle": {"enum": ["present", "partial", "missing"]},
            "oracle_note": {"type": "string"},
            "flags": {"type": "array", "items": {
              "type": "object", "required": ["id", "kind", "field", "excerpt", "evidence_type", "confidence", "note"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^F-\\d+$"},
                "lint_id": {"type": "string"},
                "kind": {"enum": ["vague_term", "unquantified_nfr", "open_ended", "undefined_reference", "weak_modal",
                                  "compound", "subjective_outcome", "missing_case", "ambiguous_pronoun",
                                  "missing_outcome", "unknown_reference", "conflict"]},
                "term": {"type": ["string", "null"]},
                "field": {"type": "string"},
                "excerpt": {"type": "string", "minLength": 1},
                "evidence_type": {"enum": ["tool", "agent_judgment"]},
                "confidence": {"$ref": "#/$defs/confidence"},
                "note": {"type": "string", "minLength": 1}
              }}}
          }}},
        "dismissed_flags": {"type": "array", "items": {
          "type": "object", "required": ["lint_id", "reason"], "additionalProperties": false,
          "properties": {"lint_id": {"type": "string"}, "reason": {"type": "string", "minLength": 10}}}},
        "dimensions": {"type": "array", "items": {
          "type": "object", "required": ["name", "weight", "score", "status", "rationale", "evidence"],
          "additionalProperties": false,
          "properties": {
            "name": {"enum": ["testability", "clarity", "completeness", "nfr", "dependencies", "size",
                              "reproduction_steps", "expected_vs_actual", "environment", "frequency", "evidence"]},
            "weight": {"type": "integer", "minimum": 1, "maximum": 3},
            "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
            "status": {"enum": ["assessed", "not_assessed", "not_applicable"]},
            "rationale": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }}},
        "questions": {"type": "array", "items": {
          "type": "object", "required": ["id", "question", "blocking", "kind", "why", "related_criteria"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^Q-\\d+$"},
            "question": {"type": "string", "minLength": 1},
            "blocking": {"type": "boolean"},
            "kind": {"enum": ["ambiguity", "missing_case", "dependency", "nfr", "scope", "reproduction"]},
            "why": {"type": "string", "minLength": 1},
            "related_criteria": {"type": "array", "items": {"type": "string"}}
          }}},
        "suggestions": {"type": "array", "items": {
          "type": "object", "required": ["id", "criterion_id", "original", "suggested", "label", "adds_behaviour"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^S-\\d+$"},
            "criterion_id": {"type": ["string", "null"]},
            "original": {"type": ["string", "null"]},
            "suggested": {"type": "string", "minLength": 1},
            "label": {"const": "suggested"},
            "adds_behaviour": {"const": false},
            "depends_on_answer": {"type": ["string", "null"]}
          }}},
        "dependencies": {"type": "array", "items": {
          "type": "object", "required": ["kind", "description", "status", "evidence"], "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["blocking_issue", "external_service", "test_data", "design", "feature_flag", "environment",
                              "other"]},
            "description": {"type": "string", "minLength": 1},
            "status": {"enum": ["named", "unstated"]},
            "evidence": {"type": "string", "minLength": 1}
          }}},
        "split_proposal": {
          "type": ["object", "null"], "required": ["reason", "parts"], "additionalProperties": false,
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "parts": {"type": "array", "minItems": 2, "items": {
              "type": "object", "required": ["title", "criteria"], "additionalProperties": false,
              "properties": {"title": {"type": "string"}, "criteria": {"type": "array", "items": {"type": "string"}}}}}
          }
        },
        "code_checks": {
          "type": "object", "required": ["status", "references"], "additionalProperties": false,
          "properties": {
            "status": {"enum": ["ran", "not_run"]},
            "reason": {"type": "string"},
            "references": {"type": "array", "items": {
              "type": "object", "required": ["name", "found", "where"], "additionalProperties": false,
              "properties": {"name": {"type": "string"}, "found": {"type": "boolean"},
                             "where": {"type": ["string", "null"]}}}}
          }
        },
        "suspicious_instructions_ignored": {"type": "array", "items": {
          "type": "object", "required": ["field", "excerpt"], "additionalProperties": false,
          "properties": {"field": {"type": "string"}, "excerpt": {"type": "string"}}}},
        "verdict": {
          "type": "object", "required": ["value", "readiness_score", "blocking_questions", "reasons"],
          "additionalProperties": false,
          "properties": {
            "value": {"$ref": "#/$defs/verdict_value"},
            "readiness_score": {"type": ["number", "null"]},
            "blocking_questions": {"type": "integer", "minimum": 0},
            "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "comment_text": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

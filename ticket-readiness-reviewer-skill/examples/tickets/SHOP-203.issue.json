    "customfield_10034": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Given a cart with a subtotal of at least $50, when the customer applies the code SUMMER10, then the subtotal is reduced by 10% and the discount is shown as a separate line."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Given an unknown code, when the customer applies it, then the message \"That code isn't valid\" is shown and the subtotal is unchanged."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The customer can remove the code, and the subtotal goes back to the original amount."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Codes are not case-sensitive."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }

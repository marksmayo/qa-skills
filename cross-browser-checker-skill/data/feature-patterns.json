{
  "note": "Syntax and API patterns mapped to web-features ids. kind: css-selector (substring of a selector), css-pseudo-regex (regex over selectors), css-at-rule, css-declaration (property regex, optional value), css-flex-gap (gap in a rule that also sets display:flex), js-api (regex over scripts), html (regex over markup), utility-class (a class token, behind any variants, in scripts and markup; only when the repo depends on Tailwind CSS). fallback lists regexes that, found in the same file, count as a feature check or alternative; emits_fallback says why every use has one (the framework writes a prefixed alternative). support overrides web-features for non-standard syntax.",
  "patterns": [
    {"feature": "has", "name": ":has()", "kind": "css-selector", "match": ":has(", "fallback": ["@supports\\s+selector\\(\\s*:has"]},
    {"feature": "flexbox-gap", "name": "gap in flexbox", "kind": "css-flex-gap", "fallback": ["@supports\\s*\\(\\s*gap"]},
    {"feature": "container-queries", "name": "@container", "kind": "css-at-rule", "match": "@container", "fallback": ["@supports\\s*\\(\\s*container"]},
    {"feature": "cascade-layers", "name": "@layer", "kind": "css-at-rule", "match": "@layer", "fallback": []},
    {"feature": "subgrid", "name": "subgrid", "kind": "css-declaration", "property": "grid-template-(columns|rows)", "value": "subgrid", "fallback": ["@supports\\s*\\([^)]*subgrid"]},
    {"feature": "text-wrap-balance", "name": "text-wrap: balance", "kind": "css-declaration", "property": "text-wrap", "value": "balance", "fallback": []},
    {"feature": "webkit-pseudo-elements", "name": "::-webkit- pseudo-elements", "kind": "css-pseudo-regex", "match": "::-webkit-[a-z-]+",
     "support": {"chrome": "1", "chrome_android": "18", "edge": "79", "safari": "3", "safari_ios": "3"}, "baseline": "non_standard",
     "fallback": ["::-moz-", "@supports\\s+selector\\(\\s*::-webkit-"]},
    {"feature": "ua-client-hints", "name": "navigator.userAgentData", "kind": "js-api", "match": "navigator\\.userAgentData(?!\\s*\\?)",
     "fallback": ["['\"]userAgentData['\"]\\s+in\\s+navigator", "typeof\\s+navigator\\.userAgentData", "navigator\\.userAgentData\\s*\\?", "if\\s*\\(\\s*navigator\\.userAgentData\\s*\\)"]},
    {"feature": "structured-clone", "name": "structuredClone()", "kind": "js-api", "match": "\\bstructuredClone\\s*\\(", "fallback": ["typeof\\s+structuredClone"]},
    {"feature": "view-transitions", "name": "document.startViewTransition()", "kind": "js-api", "match": "document\\.startViewTransition\\s*\\(", "fallback": ["if\\s*\\(\\s*!?\\s*document\\.startViewTransition"]},
    {"feature": "navigation", "name": "Navigation API", "kind": "js-api", "match": "\\bnavigation\\.(navigate|addEventListener|currentEntry)\\b", "fallback": ["['\"]navigation['\"]\\s+in\\s+window"]},
    {"feature": "dialog", "name": "<dialog>", "kind": "html", "match": "<dialog\\b", "fallback": []},
    {"feature": "popover", "name": "popover attribute", "kind": "html", "match": "\\spopover(=|\\s|>)", "fallback": []},
    {"feature": "webp", "name": "WebP images", "kind": "html", "match": "\\.webp\\b", "fallback": ["<picture"]},
    {"feature": "avif", "name": "AVIF images", "kind": "html", "match": "\\.avif\\b", "fallback": ["<picture"]},
    {"feature": "content-visibility", "name": "content-visibility", "kind": "css-declaration", "property": "content-visibility", "fallback": ["@supports\\s*\\(\\s*content-visibility"]},
    {"feature": "contain-intrinsic-size", "name": "contain-intrinsic-size", "kind": "css-declaration", "property": "contain-intrinsic-(size|width|height|block-size|inline-size)", "fallback": ["@supports\\s*\\(\\s*contain-intrinsic"]},
    {"feature": "oklab", "name": "oklch() / oklab() colours", "kind": "css-declaration", "property": "[a-z-]+", "value": "okl", "fallback": ["@supports\\s*\\([^)]*okl"]},
    {"feature": "color-mix", "name": "color-mix()", "kind": "css-declaration", "property": "[a-z-]+", "value": "color-mix(", "fallback": ["@supports\\s*\\([^)]*color-mix"]},
    {"feature": "registered-custom-properties", "name": "@property", "kind": "css-at-rule", "match": "@property", "fallback": []},
    {"feature": "text-wrap-balance", "name": "text-wrap: balance", "kind": "utility-class", "match": "text-balance(?![\\w-])", "fallback": []},
    {"feature": "text-wrap-pretty", "name": "text-wrap: pretty", "kind": "utility-class", "match": "text-pretty(?![\\w-])", "fallback": []},
    {"feature": "backdrop-filter", "name": "backdrop-filter", "kind": "utility-class", "emits_fallback": "Tailwind writes -webkit-backdrop-filter alongside backdrop-filter", "match": "backdrop-(blur|brightness|contrast|grayscale|hue-rotate|invert|opacity|saturate|sepia)(-[\\w\\[\\].%/-]+)?(?![\\w-])", "fallback": []},
    {"feature": "background-clip-text", "name": "background-clip: text", "kind": "utility-class", "match": "bg-clip-text(?![\\w-])", "fallback": []},
    {"feature": "has", "name": ":has()", "kind": "utility-class", "match": "(group-|peer-)?has-\\[[^\\]\\s]+\\]:[\\w-]+", "fallback": []},
    {"feature": "container-queries", "name": "@container", "kind": "utility-class", "match": "@container(?![\\w-])|@(3xs|2xs|xs|sm|md|lg|xl|[2-7]xl|min-\\[[^\\]]+\\]|max-\\[[^\\]]+\\]):[\\w-]+", "fallback": []},
    {"feature": "field-sizing", "name": "field-sizing", "kind": "utility-class", "match": "field-sizing-(content|fixed)(?![\\w-])", "fallback": []},
    {"feature": "starting-style", "name": "@starting-style", "kind": "utility-class", "match": "starting:[\\w-]+", "fallback": []},
    {"feature": "requestidlecallback", "name": "requestIdleCallback()", "kind": "js-api", "match": "\\brequestIdleCallback\\s*\\(", "fallback": ["['\"]requestIdleCallback['\"]\\s+in\\s+(window|self|globalThis)", "typeof\\s+(window\\.|self\\.|globalThis\\.)?requestIdleCallback", "requestIdleCallback\\s*\\|\\|", "if\\s*\\(\\s*!?\\s*(window\\.|self\\.|globalThis\\.)?requestIdleCallback\\s*\\)"]},
    {"feature": "array-at", "name": "Array.prototype.at() / String.prototype.at()", "kind": "js-api", "match": "\\.at\\(\\s*-?\\d+\\s*\\)", "fallback": []},
    {"feature": "array-findlast", "name": "findLast() / findLastIndex()", "kind": "js-api", "match": "\\.findLast(Index)?\\s*\\(", "fallback": []},
    {"feature": "array-by-copy", "name": "toSorted() / toReversed() / toSpliced()", "kind": "js-api", "match": "\\.(toSorted|toReversed|toSpliced)\\s*\\(", "fallback": []},
    {"feature": "object-hasown", "name": "Object.hasOwn()", "kind": "js-api", "match": "\\bObject\\.hasOwn\\s*\\(", "fallback": []},
    {"feature": "array-group", "name": "Object.groupBy() / Map.groupBy()", "kind": "js-api", "match": "\\b(Object|Map)\\.groupBy\\s*\\(", "fallback": ["typeof\\s+(Object|Map)\\.groupBy", "['\"]groupBy['\"]\\s+in\\s+(Object|Map)"]},
    {"feature": "set-methods", "name": "Set methods (union, intersection, ...)", "kind": "js-api", "match": "\\.(symmetricDifference|isSubsetOf|isSupersetOf|isDisjointFrom)\\s*\\(|\\b\\w*[Ss]et\\w*\\.(union|intersection|difference)\\s*\\(", "fallback": []},
    {"feature": "promise-withresolvers", "name": "Promise.withResolvers()", "kind": "js-api", "match": "\\bPromise\\.withResolvers\\s*\\(", "fallback": []},
    {"feature": "array-fromasync", "name": "Array.fromAsync()", "kind": "js-api", "match": "\\bArray\\.fromAsync\\s*\\(", "fallback": []},
    {"feature": "iterator-methods", "name": "Iterator helpers", "kind": "js-api", "match": "\\bIterator\\.from\\s*\\(|\\.(values|keys|entries)\\(\\)\\s*\\.(map|filter|take|drop|flatMap|reduce|toArray|some|every|find)\\s*\\(", "fallback": []},
    {"feature": "abortsignal-any", "name": "AbortSignal.any()", "kind": "js-api", "match": "\\bAbortSignal\\.any\\s*\\(", "fallback": []},
    {"feature": "async-clipboard", "name": "Async Clipboard API (needs a secure context)", "kind": "js-api", "match": "\\bnavigator\\.clipboard\\.(writeText|readText|write|read)\\s*\\(", "fallback": ["navigator\\.clipboard\\s*\\?\\.", "if\\s*\\(\\s*!?\\s*navigator\\.clipboard\\b", "['\"]clipboard['\"]\\s+in\\s+navigator"]},
    {"feature": "string-replaceall", "name": "String.prototype.replaceAll()", "kind": "js-api", "match": "\\.replaceAll\\s*\\(", "fallback": []},
    {"feature": "promise-any", "name": "Promise.any()", "kind": "js-api", "match": "\\bPromise\\.any\\s*\\(", "fallback": []},
    {"feature": "intl-segmenter", "name": "Intl.Segmenter", "kind": "js-api", "match": "\\bnew\\s+Intl\\.Segmenter\\s*\\(", "fallback": ["typeof\\s+Intl\\.Segmenter", "['\"]Segmenter['\"]\\s+in\\s+Intl"]},
    {"feature": "weak-references", "name": "WeakRef / FinalizationRegistry", "kind": "js-api", "match": "\\bnew\\s+(WeakRef|FinalizationRegistry)\\s*\\(", "fallback": ["typeof\\s+(WeakRef|FinalizationRegistry)"]},
    {"feature": "error-cause", "name": "Error cause", "kind": "js-api", "match": "\\bnew\\s+\\w*Error\\s*\\([^;]*?\\{\\s*cause\\s*:", "fallback": []}
  ]
}

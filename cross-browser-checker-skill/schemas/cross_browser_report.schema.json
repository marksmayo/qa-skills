{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/cross-browser-checker/cross_browser_report.schema.json",
  "title": "Cross-browser report",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "scope", "metadata", "headline", "differences", "feature_findings", "flaky", "dismissed_automatically",
               "needs_review", "triage", "limitations"],
  "properties": {
    "skill": {"type": "object", "additionalProperties": false, "required": ["name", "version"],
              "properties": {"name": {"enum": ["cross-browser-checker"]}, "version": {"type": "string"}}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["site", "pages", "viewports", "engines", "reference_engine", "browserslist", "out_of_scope", "reruns", "authorised_by"],
      "properties": {
        "site": {"type": ["string", "null"]},
        "pages": {"type": "array", "items": {"type": "string"}},
        "viewports": {"type": "array", "items": {"type": "string"}},
        "engines": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "status", "note"],
          "properties": {"name": {"enum": ["chromium", "firefox", "webkit", "chrome", "msedge"]}, "version": {"type": ["string", "null"]},
                         "status": {"enum": ["ran", "not_run", "errored"]}, "note": {"type": ["string", "null"]}}}},
        "reference_engine": {"type": "string"},
        "browserslist": {"type": "object", "required": ["query", "source", "resolved_count", "coverage", "unresolved"]},
        "out_of_scope": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "reruns": {"type": "integer", "minimum": 1},
        "authorised_by": {"type": ["string", "null"]},
        "third_party": {"type": ["object", "null"], "additionalProperties": false, "required": ["mode", "allowed_hosts", "blocked"],
                        "description": "What the harness did with requests to third-party hosts, as compare_engines.py summarises runs.json (candidates.json third_party). Required when the capture recorded it. Blocked requests' behaviour was not compared.",
                        "properties": {"mode": {"enum": ["block", "allow"]}, "allowed_hosts": {"type": "array", "items": {"type": "string"}},
                                       "blocked": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["host", "requests"],
                                                                              "properties": {"host": {"type": "string"}, "requests": {"type": "integer", "minimum": 1}}}}}}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["generated_at", "tools", "data", "runs_file"],
      "properties": {
        "generated_at": {"type": "string"},
        "tools": {"type": "array", "items": {"type": "object", "required": ["name", "version", "status", "note"]}},
        "data": {"type": "object"},
        "runs_file": {"type": "string"}
      }
    },
    "headline": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "summary", "severity_counts", "flaky_count", "checks", "evidence_completeness", "overall_confidence"],
      "properties": {
        "verdict": {"enum": ["differences_found", "no_differences_detected"]},
        "summary": {"type": "string", "minLength": 20},
        "severity_counts": {"type": "object"},
        "flaky_count": {"type": "integer"},
        "checks": {"type": "object", "additionalProperties": false, "required": ["planned", "ran"],
                   "properties": {"planned": {"type": "integer"}, "ran": {"type": "integer"}}},
        "evidence_completeness": {"enum": ["complete", "partial"]},
        "overall_confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "differences": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "candidate_id", "title", "kind", "subkind", "engines_affected", "reference", "page", "states", "element", "severity",
                   "confidence", "priority", "score", "usage_share", "runs", "evidence", "cause", "remediation", "verification_step"],
      "properties": {
        "id": {"type": "string", "pattern": "^D[0-9]+$"},
        "candidate_id": {"type": "string"},
        "title": {"type": "string", "minLength": 10},
        "kind": {"enum": ["error", "layout", "behaviour", "network"]},
        "subkind": {"type": "string"},
        "engines_affected": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reference": {"type": "string"},
        "page": {"type": "string"},
        "states": {"type": "array", "items": {"type": "string"}},
        "element": {"type": ["string", "null"]},
        "severity": {"enum": ["Critical", "High", "Medium", "Low"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "score": {"type": "integer"},
        "usage_share": {"type": ["number", "null"]},
        "runs": {"type": "object"},
        "evidence": {"type": "array", "minItems": 2, "items": {
          "type": "object", "additionalProperties": false, "required": ["engine", "screenshots", "messages"],
          "properties": {"engine": {"type": "string"}, "screenshots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                         "messages": {"type": "array", "items": {"type": "string"}}}}},
        "cause": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["features", "explanation"]}]},
        "remediation": {"type": "string", "minLength": 10},
        "verification_step": {"type": "string", "minLength": 10}
      }
    }},
    "feature_findings": {"type": "array", "items": {
      "type": "object", "required": ["feature", "name", "files", "unsupported_in", "fallback", "status", "linked_differences"],
      "properties": {"status": {"enum": ["possible", "confirmed_at_runtime", "not_assessed"]}}}},
    "flaky": {"type": "array"},
    "dismissed_automatically": {"type": "integer", "minimum": 0},
    "needs_review": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "reason"]}},
    "triage": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "decision", "difference_id", "reason"],
      "properties": {"candidate_id": {"type": "string"}, "decision": {"enum": ["promoted", "needs_review", "dismissed"]},
                     "difference_id": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 10}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

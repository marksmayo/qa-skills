{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/mobile-app-auditor/mobile_audit.schema.json",
  "title": "Mobile app audit",
  "type": "object",
  "required": ["schema_version", "skill", "generated_at", "scope", "metadata", "headline", "sc_results", "findings", "advisories", "needs_review",
               "triage", "crashes", "screen_graph", "manual_test_plan", "assisted_review", "limitations", "files_written"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill": {"const": "mobile-app-auditor"},
    "generated_at": {"type": "string"},
    "scope": {"type": "object", "required": ["app", "platforms", "devices", "wcag_version", "level", "exploration", "sample", "critical_paths"],
      "properties": {
        "app": {"type": "object", "required": ["package", "apk_sha256"]},
        "platforms": {"type": "object", "properties": {"android": {"enum": ["ran", "not_run"]}, "ios": {"enum": ["ran", "not_run"]}}},
        "devices": {"type": "array", "items": {"type": "object", "required": ["model", "android", "api", "density"]}},
        "wcag_version": {"enum": ["2.0", "2.1", "2.2"]}, "level": {"enum": ["A", "AA"]},
        "exploration": {"enum": ["guided", "random", "both", "off"]},
        "authorised_by": {"type": ["string", "null"]},
        "sample": {"type": "array", "items": {"type": "object", "required": ["id", "activity", "reason"],
          "properties": {"reason": {"enum": ["structured", "critical_path", "random", "unreachable", "blocked"]}}}},
        "critical_paths": {"type": "array", "items": {"type": "object", "required": ["name", "steps"]}}}},
    "metadata": {"type": "object", "required": ["host", "tools", "checks", "settings_changed"],
      "properties": {"tools": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"status": {"enum": ["ran", "not_run", "errored"]}}}},
                     "checks": {"type": "array", "items": {"type": "object", "required": ["screen", "kind", "name", "status"],
                       "properties": {"kind": {"enum": ["engine", "probe"]}, "status": {"enum": ["ran", "not_run", "errored", "blocked"]}}}},
                     "settings_changed": {"type": "array"}}},
    "headline": {"type": "object", "required": ["conformance_verdict", "verdict_text", "severity_counts", "sc_coverage", "evidence_completeness",
                                                 "overall_confidence", "blocked_critical_paths", "crash_counts"],
      "properties": {"conformance_verdict": {"enum": ["does_not_conform", "not_established"]}, "overall_confidence": {"enum": ["high", "medium", "low"]}}},
    "sc_results": {"type": "array", "items": {"type": "object", "required": ["sc", "title", "level", "principle", "outcome", "confidence", "automatable", "finding_ids", "basis", "evidence_note", "en301549_clause"],
      "properties": {"outcome": {"enum": ["passed", "failed", "cantTell", "inapplicable", "untested"]}, "confidence": {"enum": ["high", "medium", "low"]},
                     "basis": {"enum": ["tool", "probe", "probe_and_agent", "agent_judgment", "human", "none"]}, "en301549_clause": {"type": ["string", "null"]}}}},
    "findings": {"type": "array", "items": {"type": "object",
      "required": ["id", "title", "sc", "level", "pattern", "base_severity", "severity", "severity_rationale", "confidence", "priority", "evidence_type", "sources",
                   "candidate_ids", "component", "screens", "instances", "user_impact", "affected_users", "remediation", "verification_step", "non_interference",
                   "critical_path", "blocks_critical_path", "en301549"],
      "properties": {
        "severity": {"enum": ["minor", "moderate", "serious", "critical"]}, "base_severity": {"enum": ["minor", "moderate", "serious", "critical"]},
        "confidence": {"enum": ["high", "medium", "low"]}, "evidence_type": {"enum": ["tool", "probe", "agent_judgment"]},
        "priority": {"type": "object", "required": ["weight", "reach", "leverage", "score", "band"]},
        "instances": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["screen", "element", "screenshot", "device"],
          "properties": {"element": {"type": "object", "required": ["bounds"]}, "sha256": {"type": ["string", "null"]}}}}}}},
    "advisories": {"type": "array"}, "needs_review": {"type": "array"},
    "triage": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "decision"],
      "properties": {"decision": {"enum": ["finding", "needs_review", "advisory", "crash", "dismissed"]}}}},
    "crashes": {"type": "array", "items": {"type": "object",
      "required": ["id", "candidate_id", "kind", "title", "crash_ids", "tier", "reach", "likelihood", "recoverability", "confidence", "priority", "steps", "log_excerpt", "screenshot", "replay", "fix", "verification"],
      "properties": {"kind": {"enum": ["crash", "anr", "hang"]}, "tier": {"enum": ["B1", "B2"]}, "reach": {"enum": [1, 2, 3]},
                     "likelihood": {"enum": ["normal_use", "unusual_sequence", "state_change", "random_only"]},
                     "recoverability": {"enum": ["crash_loop", "restart", "retry"]}, "confidence": {"enum": ["reproduced", "observed"]},
                     "priority": {"type": "object", "required": ["score", "band"]}}}},
    "screen_graph": {"type": "object", "required": ["screens", "edges"]},
    "manual_test_plan": {"type": "array", "items": {"type": "object", "required": ["sc", "title", "why_untested", "steps"]}},
    "assisted_review": {"type": "object", "required": ["scs_reviewed", "method", "notes"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "files_written": {"type": "array", "items": {"type": "string"}}
  }
}

  "fields": {
    "summary": "Customers can apply a discount code at checkout",
    "issuetype": {"name": "Story"},
    "status": {"name": "Ready for Dev"},
    "priority": {"name": "High"},
    "labels": ["promotions"],
    "components": [{"name": "checkout"}],
    "fixVersions": [{"name": "2026.12"}],
    "parent": {"key": "BILL-100", "fields": {"summary": "Promotions", "issuetype": {"name": "Epic"}}},
    "description": {
      "type": "doc", "version": 1,
      "content": [
        {"type": "paragraph", "content": [
          {"type": "text", "text": "Marketing wants customers to be able to enter a promotion code in the cart. Codes are set up by the promo team in "},
          {"type": "text", "text": "bookshop.promotions", "marks": [{"type": "code"}]},
          {"type": "text", "text": "."}
        ]},
        {"type": "heading", "attrs": {"level": 3}, "content": [{"type": "text", "text": "Notes"}]},
        {"type": "bulletList", "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Discounts don't apply to gift cards."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Shipping is calculated later, at payment, and is out of scope for this story."}]}]}
        ]}
      ]
    },
    "customfield_10034": {
      "type": "doc", "version": 1,
      "content": [
        {"type": "orderedList", "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Given a cart whose subtotal is at least the code's minimum spend, when a valid percentage code is applied, then the total is reduced by that percentage, rounded to the nearest cent."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Codes are case-insensitive and ignore surrounding spaces."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "An expired code is rejected with the message \"This code has expired\" and the total is unchanged."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Only one code can be applied per cart; applying a second code replaces the first."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "If the subtotal is below the code's minimum spend, the code is rejected with \"Spend $X more to use this code\", where X is the shortfall."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The discount appears as a separate line on the order confirmation email."}]}]}
        ]}
      ]
    },
    "subtasks": [],
    "issuelinks": [
      {"type": {"name": "Relates", "outward": "relates to", "inward": "relates to"},
       "outwardIssue": {"key": "BILL-120", "fields": {"summary": "Promotions admin: create percentage codes"}}}
    ],

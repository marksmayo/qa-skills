{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marksmayo/qa-skills/bug-reproducer-skill/schemas/repro_report.schema.json",
  "title": "Bug reproduction report (one report, or a batch of them)",
  "oneOf": [
    {"$ref": "#/$defs/report"},
    {
      "type": "object",
      "required": ["batch", "reports", "summary"],
      "properties": {
        "batch": {
          "type": "object",
          "required": ["generated", "source", "reports_reviewed"],
          "properties": {
            "generated": {"type": "string"},
            "source": {"type": "string"},
            "reports_reviewed": {"type": "integer", "minimum": 1}
          }
        },
        "reports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/report"}},
        "summary": {
          "type": "object",
          "required": ["by_outcome", "likely_duplicates", "regression_tests_written"],
          "properties": {
            "by_outcome": {"type": "object"},
            "likely_duplicates": {"type": "array", "items": {"type": "string"}},
            "regression_tests_written": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "required": ["key", "headline", "metadata", "triage", "signature", "attempts", "outcome", "duplicates", "localisation",
                   "rating", "skipped_steps", "files_written", "limitations"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "headline": {"type": "string", "minLength": 10},
        "metadata": {
          "type": "object",
          "required": ["report", "target", "browsers", "tools", "config", "generated"],
          "properties": {
            "report": {
              "type": "object",
              "required": ["key", "source", "content_sha256"],
              "properties": {
                "key": {"type": "string"},
                "source": {"enum": ["jira", "github", "pasted", "connector"]},
                "url": {"type": ["string", "null"]},
                "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "summary": {"type": "string"}
              }
            },
            "target": {
              "type": "object",
              "required": ["url", "version_stated", "versions_observed", "authorised_by"],
              "properties": {
                "url": {"type": ["string", "null"]},
                "build": {"type": ["string", "null"]},
                "version_stated": {"type": ["string", "null"]},
                "versions_observed": {"type": "array", "items": {"type": "string"}},
                "authorised_by": {"type": ["string", "null"]}
              }
            },
            "browsers": {
              "type": "array",
              "items": {"type": "object", "required": ["name", "version"], "properties": {"name": {"enum": ["chromium", "firefox", "webkit"]}, "version": {"type": "string"}}}
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "status"],
                "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]}, "status": {"enum": ["ran", "not_run", "errored"]}, "note": {"type": "string"}}
              }
            },
            "config": {
              "type": "object",
              "required": ["attempts", "write_regression_test", "duplicate_search"],
              "properties": {
                "attempts": {"type": "integer", "minimum": 1},
                "write_regression_test": {"enum": ["propose", "on", "off"]},
                "duplicate_search": {"enum": ["on", "off"]},
                "allow_form_submission": {"type": "boolean"}
              }
            },
            "generated": {"type": "string"}
          }
        },
        "triage": {
          "type": "object",
          "required": ["fields_present", "fields_missing", "questions", "suspicious_instructions_ignored"],
          "properties": {
            "fields_present": {"type": "array", "items": {"$ref": "#/$defs/field"}},
            "fields_missing": {"type": "array", "items": {"$ref": "#/$defs/field"}},
            "questions": {"type": "array", "items": {"type": "string"}},
            "suspicious_instructions_ignored": {"type": "array", "items": {"type": "string"}}
          }
        },
        "signature": {
          "type": "object",
          "required": ["raw_excerpt", "normalised", "failure_checks", "basis"],
          "properties": {
            "raw_excerpt": {"type": ["string", "null"]},
            "normalised": {"type": ["string", "null"]},
            "failure_checks": {"type": ["object", "null"]},
            "basis": {"enum": ["report_text", "stack_trace", "log", "screenshot_agent_judgment", "none"]}
          }
        },
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "outcome": {
          "type": "object",
          "required": ["value", "confidence", "matched_attempts", "total_attempts", "versions_tried", "basis_candidate", "only_after_variation"],
          "properties": {
            "value": {"enum": ["reproduced", "reproduced_differently", "not_reproduced", "cannot_attempt"]},
            "confidence": {"enum": ["high", "medium", "low", "n/a"]},
            "matched_attempts": {"type": "integer", "minimum": 0},
            "total_attempts": {"type": "integer", "minimum": 0},
            "all_attempts": {"type": "object", "properties": {"matched": {"type": "integer"}, "total": {"type": "integer"}}},
            "versions_tried": {"type": "array", "items": {"type": "string"}},
            "basis_candidate": {"type": ["string", "null"]},
            "only_after_variation": {"type": "boolean"},
            "fixed_in_candidate": {"type": ["string", "null"]},
            "reason": {"type": "string"}
          }
        },
        "minimal_repro": {
          "type": ["object", "null"],
          "required": ["steps", "removed_steps", "script_path", "confirmed", "artifacts"],
          "properties": {
            "steps": {"type": "array", "minItems": 1},
            "removed_steps": {"type": "array"},
            "script_path": {"type": "string"},
            "confirmed": {"type": "string", "pattern": "^\\d+ of \\d+$"},
            "artifacts": {"type": "array", "items": {"type": "string"}},
            "trials": {"type": "integer", "minimum": 1}
          }
        },
        "duplicates_searched": {"type": "integer", "minimum": 0},
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "similarity", "verdict", "components"],
            "properties": {
              "key": {"type": "string"},
              "summary": {"type": ["string", "null"]},
              "similarity": {"type": "number", "minimum": 0, "maximum": 1},
              "verdict": {"enum": ["likely_duplicate", "related"]},
              "components": {
                "type": "object",
                "required": ["signature", "summary", "component"],
                "properties": {"signature": {"enum": [0, 1]}, "summary": {"type": "number"}, "component": {"enum": [0, 1]}}
              }
            }
          }
        },
        "localisation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "evidence", "commits", "confidence"],
            "properties": {
              "file": {"type": "string"},
              "line": {"type": ["integer", "null"]},
              "code": {"type": "string"},
              "evidence": {"type": "string", "minLength": 10},
              "commits": {"type": "array", "items": {"type": "object", "required": ["sha", "subject"], "properties": {"sha": {"type": "string"}, "date": {"type": "string"}, "subject": {"type": "string"}}}},
              "confidence": {"enum": ["high", "medium", "low"]}
            }
          }
        },
        "rating": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["severity", "severity_reason", "reach", "reach_reason", "frequency", "score", "priority", "basis", "confidence"],
              "properties": {
                "severity": {"enum": ["S1", "S2", "S3", "S4"]},
                "severity_reason": {"type": "string", "minLength": 10},
                "reach": {"enum": [1, 2, 3]},
                "reach_reason": {"type": "string", "minLength": 5},
                "frequency": {"enum": [1, 2, 3]},
                "score": {"type": "integer"},
                "priority": {"enum": ["P0", "P1", "P2", "P3"]},
                "basis": {"enum": ["reproduced", "as_reported"]},
                "confidence": {"enum": ["high", "medium", "low"]},
                "reporter_label": {"type": ["string", "null"]},
                "route_to": {"type": "array", "items": {"type": "string"}}
              }
            }
          ]
        },
        "regression_test": {
          "type": ["object", "null"],
          "required": ["status"],
          "properties": {
            "status": {"enum": ["written", "proposed", "not_proposed", "covered_by"]},
            "path": {"type": ["string", "null"]},
            "framework": {"type": ["string", "null"]},
            "approval": {"type": ["string", "null"]},
            "reason": {"type": "string"},
            "covered_by": {"type": "string"},
            "red": {
              "type": ["object", "null"],
              "required": ["status", "failure_excerpt", "run_id", "runs_file"],
              "properties": {
                "status": {"enum": ["assertion_failure", "error", "passed"]},
                "failure_excerpt": {"type": "string"},
                "run_id": {"type": "string"},
                "runs_file": {"type": "string"},
                "cases": {"type": "array", "items": {"type": "string"}}
              }
            },
            "fix_check": {"type": "string"}
          }
        },
        "skipped_steps": {
          "type": "array",
          "items": {"type": "object", "required": ["text", "reason"], "properties": {"text": {"type": "string"}, "reason": {"type": "string"}, "instead": {"type": "string"}}}
        },
        "files_written": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "next_steps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "field": {"enum": ["summary", "steps", "expected", "actual", "environment", "version", "frequency"]},
    "attempt": {
      "type": "object",
      "required": ["id", "candidate", "channel", "version", "environment", "steps", "assumptions", "result", "artifacts"],
      "properties": {
        "id": {"type": "string"},
        "candidate": {"type": "string"},
        "label": {"type": ["string", "null"]},
        "variation": {"type": ["string", "null"]},
        "channel": {"enum": ["browser", "test", "http", "mobile"]},
        "browser": {"type": ["string", "null"]},
        "browser_version": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "version_stated": {"type": ["string", "null"]},
        "environment": {"type": "object"},
        "steps": {"type": "array"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "result": {"enum": ["matched", "different", "no_failure", "errored"]},
        "observed_signature": {"type": ["string", "null"]},
        "checks": {"type": ["string", "null"]},
        "observed": {"type": "object"},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "run": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}

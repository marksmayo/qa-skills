{
  "$comment": "Patterns used by scan_tests.py. Python is parsed with ast; JavaScript/TypeScript with these patterns and bracket matching.",
  "python": {
    "default_python_files": ["test_*.py", "*_test.py"],
    "default_python_functions": ["test*"],
    "default_python_classes": ["Test*"],
    "assert_calls": "^(assert\\w*|expect\\w*|verify\\w*|should\\w*|check_that|fail)$",
    "raises_contexts": ["raises", "warns", "assertRaises", "assertRaisesRegex", "assertWarns", "assertLogs", "deprecated_call"],
    "skip_decorators": ["skip", "skipif", "xfail", "skipIf", "skipUnless", "expectedFailure"],
    "patch_calls": ["patch", "patch.object", "MagicMock", "Mock", "create_autospec"]
  },
  "javascript": {
    "$comment": "Calls are found by scan_tests.py's lexer and call walker (describe/suite/it/test/xit/xtest/fit/xdescribe/fdescribe, Playwright test.describe, aliases such as `test as setup`); assert_pattern is matched in comment- and string-masked code.",
    "test_files": ["*.test.ts", "*.test.tsx", "*.test.js", "*.test.jsx", "*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx", "*.test.mjs", "*.spec.mjs",
                   "*.test.mts", "*.spec.mts", "*.test.cjs", "*.spec.cjs"],
    "playwright_setup_files": ["*.setup.ts", "*.setup.js", "*.setup.mts", "*.setup.mjs"],
    "skip_markers": ["it.skip", "test.skip", "describe.skip", "xit", "xtest", "xdescribe", "it.todo", "test.todo", "test.fixme", "it.skipIf", "test.skipIf"],
    "only_markers": ["it.only", "test.only", "describe.only", "fit", "fdescribe", "test.describe.only"],
    "assert_pattern": "\\bexpect(\\s*\\.\\s*(soft|poll))?\\s*\\(|\\bexpect\\s*\\.\\s*(assertions|hasAssertions)\\s*\\(|\\bassert(\\.\\w+)?\\s*\\(|\\b(expect|assert|verify)[A-Z]\\w*\\s*\\(|\\bexpectTypeOf\\s*\\(|\\bassertType\\s*\\(|\\.toMatchSnapshot\\s*\\(|\\.toMatchInlineSnapshot\\s*\\(|\\.toHaveScreenshot\\s*\\(",
    "duplicate_min_tokens": 40,
    "duplicate_similarity": 1.0
  },
  "ticket_key": "\\b([A-Z][A-Z0-9]+-\\d+)\\b",
  "done_categories": ["done"],
  "done_statuses": ["done", "closed", "resolved", "won't do", "wont do", "cancelled", "canceled", "rejected", "released"],
  "skip_age_days": 180,
  "similarity_threshold": 0.9
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/post-deploy-validator/pvt_report.schema.json",
  "title": "Post-deploy validation report",
  "type": "object",
  "required": ["schema_version", "skill", "run", "target", "plan", "deployed", "window", "credential_sets", "checks", "performance", "findings", "recommendation", "summary", "limitations"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "skill": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "post-deploy-validator"}}},
    "deployed": {"type": "object", "required": ["version", "expected", "matches", "source", "deployment_id", "deployment_source"],
      "description": "matches is true when the expected value equals the version or the deployment id, null when neither could be read."},
    "window": {"type": "object", "required": ["started_at", "finished_at", "requests_sent", "blocked", "stopped"],
      "properties": {"stopped": {"type": ["object", "null"], "required": ["cause", "after_check", "http_status"],
        "properties": {"cause": {"enum": ["app_5xx", "rate_limited", "waf"]}}}}},
    "credential_sets": {"type": "array", "items": {"type": "object", "required": ["name", "available", "signed_in"]}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "critical", "method", "path", "status", "http_status", "final_path", "reason"],
      "properties": {"status": {"enum": ["pass", "fail", "error", "blocked", "skipped"]}}}},
    "performance": {"type": "object", "required": ["baseline_run", "baseline_relation", "tolerance_pct", "min_delta_ms", "samples", "comparisons"],
      "properties": {"baseline_relation": {"enum": [null, "same_deployment", "same_version", "different_deployment", "different_version", "unknown"]},
        "comparisons": {"type": "array", "items": {"type": "object", "required": ["check_id", "median_ms", "baseline_median_ms", "change_pct", "status"],
        "properties": {"status": {"enum": ["regressed", "ok", "improved", "no_baseline", "not_comparable"]}}}}}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "severity", "check_ids", "title", "evidence"],
      "properties": {"kind": {"enum": ["version_mismatch", "check_failed", "regression", "header_inconsistent"]}, "severity": {"enum": ["critical", "major", "minor"]}}}},
    "recommendation": {"type": "object", "required": ["value", "reasons", "notes", "decision_owner", "decided_by", "decision"],
      "properties": {"value": {"enum": ["go", "no_go", "not_established"]}, "decided_by": {"type": "null"}, "decision": {"type": "null"}}},
    "summary": {"type": "object", "required": ["headline", "checks", "findings"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

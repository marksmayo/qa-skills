{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qa-skills/post-deploy-validator/pvt_plan.schema.json",
  "title": "Post-deploy check plan",
  "description": "run_pvt.py and validate_pvt.py check a plan against this schema before anything is sent; unknown fields (a typo such as \"critcal\") are errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "target", "version", "checks", "performance"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "name": {"type": "string"},
    "note": {"type": "string"},
    "target": {"type": "object", "additionalProperties": false, "required": ["base_url", "environment"],
      "properties": {"base_url": {"type": "string", "pattern": "^https?://"}, "environment": {"enum": ["production", "staging", "test"]},
                     "authorised_by": {"type": "string"}},
      "if": {"properties": {"environment": {"const": "production"}}}, "then": {"required": ["authorised_by"]}},
    "version": {"$ref": "#/$defs/reader"},
    "deployment": {"$ref": "#/$defs/reader"},
    "login_paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
    "credential_sets": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["env", "login"],
      "properties": {"env": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
                     "login": {"type": "object", "additionalProperties": false, "required": ["path", "token_json_path"],
                               "properties": {"method": {"const": "POST"}, "path": {"type": "string", "pattern": "^/"}, "body": {"type": "object"},
                                              "token_json_path": {"type": "string"}}}}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "expect"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["page", "api", "data"]}, "method": {"type": "string"},
                     "path": {"type": "string", "pattern": "^/"}, "critical": {"type": "boolean"}, "timed": {"type": "boolean"},
                     "credential_set": {"type": "string"}, "note": {"type": "string"},
                     "expect": {"type": "object", "additionalProperties": false, "properties": {
                       "status": {"type": "integer"},
                       "contains": {"type": "array", "items": {"type": "string"}},
                       "not_contains": {"type": "array", "items": {"type": "string"}},
                       "json": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "op"],
                         "properties": {"path": {"type": "string"}, "value": {},
                                        "op": {"enum": ["exists", "eq", "ne", "gt", "ge", "lt", "le", "len_ge", "len_le", "all_gt", "all_ge", "all_lt", "all_le", "unique", "matches", "fresh_within_minutes"]},
                                        "record": {"type": "boolean"}}}},
                       "headers": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
                         "properties": {"present": {"const": true}, "absent": {"const": true}, "equals": {"type": "string"}, "contains": {"type": "string"}}}},
                       "no_redirect": {"type": "boolean"},
                       "final_path": {"type": "string", "pattern": "^/"},
                       "allow_login_redirect": {"type": "boolean"}}}}}},
    "performance": {"type": "object", "additionalProperties": false,
                    "properties": {"samples": {"type": "integer", "minimum": 1}, "tolerance_pct": {"type": "number"}, "min_delta_ms": {"type": "number"}}},
    "rate_per_second": {"type": "number", "exclusiveMinimum": 0}
  },
  "$defs": {
    "reader": {"type": "object", "additionalProperties": false, "required": ["path"],
      "description": "Where to read the value: a JSON field (json_path), a response header, an HTML meta tag by name (meta), or the first group of a regular expression over the body (regex, e.g. data-dpl-id=\"([^\"]+)\").",
      "properties": {"path": {"type": "string", "pattern": "^/"}, "json_path": {"type": "string"}, "header": {"type": "string"},
                     "meta": {"type": "string"}, "regex": {"type": "string"}}}
  }
}

{
  "note": "The fault catalogue. Every fault is injected in the browser (Playwright routing or context.set_offline); nothing reaches a server in a broken form. likelihood is how often the fault happens in real life (RUBRIC.md).",
  "groups": {
    "latency": {"likelihood": 3},
    "server_error": {"likelihood": 3},
    "timeout": {"likelihood": 3},
    "offline": {"likelihood": 3},
    "static_asset": {"likelihood": 3},
    "rate_limit": {"likelihood": 2},
    "auth_expiry": {"likelihood": 2},
    "partial": {"likelihood": 2},
    "connection": {"likelihood": 2},
    "flapping": {"likelihood": 2},
    "payload": {"likelihood": 1}
  },
  "faults": {
    "slow_3s": {"group": "latency", "action": "delay", "ms": 3000},
    "slow_15s": {"group": "latency", "action": "delay", "ms": 15000},
    "http_500": {"group": "server_error", "action": "fulfill", "status": 500, "body": {"error": "Internal Server Error"}},
    "http_502": {"group": "server_error", "action": "fulfill", "status": 502, "body": "<html><body><h1>502 Bad Gateway</h1></body></html>", "content_type": "text/html"},
    "http_503_retry_after": {"group": "server_error", "action": "fulfill", "status": 503, "headers": {"Retry-After": "5"}, "body": {"error": "Service Unavailable"}},
    "http_504": {"group": "server_error", "action": "fulfill", "status": 504, "body": {"error": "Gateway Timeout"}},
    "http_429_retry_after": {"group": "rate_limit", "action": "fulfill", "status": 429, "headers": {"Retry-After": "5"}, "body": {"error": "Too Many Requests"}},
    "http_429": {"group": "rate_limit", "action": "fulfill", "status": 429, "body": {"error": "Too Many Requests"}},
    "http_401": {"group": "auth_expiry", "action": "fulfill", "status": 401, "body": {"error": "Unauthorized"}},
    "http_403": {"group": "auth_expiry", "action": "fulfill", "status": 403, "body": {"error": "Forbidden"}},
    "hang": {"group": "timeout", "action": "hang"},
    "hang_then_abort": {"group": "timeout", "action": "delay_abort", "ms": 30000, "error": "timedout"},
    "connection_reset": {"group": "connection", "action": "abort", "error": "connectionreset"},
    "connection_refused": {"group": "connection", "action": "abort", "error": "connectionrefused"},
    "disconnected": {"group": "connection", "action": "abort", "error": "internetdisconnected"},
    "offline": {"group": "offline", "action": "offline"},
    "empty_body": {"group": "payload", "action": "fulfill", "status": 200, "body": ""},
    "empty_object": {"group": "payload", "action": "fulfill", "status": 200, "body": {}},
    "empty_array": {"group": "payload", "action": "fulfill", "status": 200, "body": []},
    "wrong_content_type": {"group": "payload", "action": "fulfill", "status": 200, "body": "ok", "content_type": "text/plain"},
    "truncated_json": {"group": "payload", "action": "fulfill", "status": 200, "body": "{\"items\": [{\"title\": \"Tra", "content_type": "application/json"},
    "html_200": {"group": "payload", "action": "fulfill", "status": 200, "body": "<html><body>Maintenance</body></html>", "content_type": "text/html"},
    "huge_5mb": {"group": "payload", "action": "fulfill", "status": 200, "body_size": 5000000},
    "partial_500": {"group": "partial", "action": "fulfill", "status": 500, "body": {"error": "Internal Server Error"}},
    "flap_twice": {"group": "flapping", "action": "flap", "failures": 2, "status": 500},
    "asset_abort": {"group": "static_asset", "action": "abort", "error": "failed"}
  },
  "standard_set": ["slow_3s", "http_500", "http_503_retry_after", "http_429_retry_after", "http_401", "hang", "connection_reset", "offline",
                   "truncated_json", "partial_500", "flap_twice", "asset_abort"]
}
